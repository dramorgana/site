---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Dra. Especialista | Emagrecimento Guiado pela Ciência — Saúde Metabólica"
>
	<main>
		<!-- ============================================ -->
		<!-- SEÇÃO 02 — Hero Section (Primeira Dobra)     -->
		<!-- ============================================ -->
		<section id="hero" class="hero">
			<!-- Background image full-bleed -->
			<div class="hero__bg">
				<img
					src="/images/hero-health-weight-loss.png"
					alt="Saúde metabólica e emagrecimento — vegetais frescos, água com limão e estetoscópio em ambiente premium"
					class="hero__bg-image"
					width="1440"
					height="900"
					loading="eager"
					fetchpriority="high"
				/>
				<div class="hero__bg-overlay"></div>
			</div>

			<!-- Content Container -->
			<div class="hero__container">
				<div class="hero__card">
					<!-- Identidade Médica (SEO H1) -->
					<header class="hero__doctor">
						<h1 class="hero__doctor-name">
							<em>Dra.</em> Carolina Mendes
							<span class="hero__doctor-specialty"
								>Emagrecimento & Saúde Metabólica</span
							>
						</h1>
						<div class="hero__divider"></div>
						<p class="hero__doctor-credentials">
							CRM 00000 • RQE 00000
						</p>
					</header>

					<!-- Headline de Impacto (H2) -->
					<h2 class="hero__headline">
						Sente que seu esforço<br />
						não gera resultados?<br />
						<span class="hero__headline-accent"
							>Sua jornada para o peso ideal começa aqui.</span
						>
					</h2>

					<!-- CTA — WhatsApp -->
					<div class="hero__actions">
						<a
							href="https://wa.me/5500000000000?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20minha%20avalia%C3%A7%C3%A3o%20m%C3%A9dica."
							target="_blank"
							rel="noopener noreferrer"
							class="hero__cta"
							id="hero-cta-whatsapp"
						>
							<svg
								class="hero__cta-icon"
								viewBox="0 0 24 24"
								fill="currentColor"
								width="22"
								height="22"
							>
								<path
									d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.432.178.88.28 1.21.085.33-.198.614-.735.794-.545.18-.99.131-1.29-.069-.297-.149-.57-.347-.708-.57-.546-.09-.347-.297-.198-.56l.016-.03c.18-.313.381-.3.545-.3.164 0 .347.002.496.007.163.006.382-.062.581.44.204.516.694 1.7.752 1.822.059.123.1.267.02.428-.079.16-.119.26-.238.397-.119.138-.249.317-.397.486-.149.168-.306.189-.545.064-.237-.124-1.006-.463-1.912-1.488-.674-.765-1.141-1.712-1.19-2.034-.05-.322.035-.513.262-.676l.042-.046c.198-.215.42-.347.669-.347z"
								></path>
								<path
									d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.96 7.96 0 01-4.108-1.14l-.292-.176-2.848.846.846-2.848-.176-.292A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"
								></path>
							</svg>
							Agendar Minha Avaliação
						</a>
					</div>
				</div>
			</div>
		</section>
		<!-- ============================================ -->
		<!-- SEÇÃO 03 — Sobre a Médica (Autoridade)       -->
		<!-- ============================================ -->
		<section id="about" class="about">
			<div class="about__container">
				<!-- Lado do Conteúdo -->
				<div class="about__content">
					<header class="about__header">
						<span class="about__kicker"
							>Autoridade & Acolhimento</span
						>
						<h2 class="about__title">
							Uma abordagem humana para resultados reais.
						</h2>
						<div class="about__divider"></div>
					</header>

					<div class="about__body">
						<p class="about__text">
							Acredito que o emagrecimento não é apenas sobre
							números na balança, mas sobre a reconquista da
							autonomia sobre o próprio corpo.
						</p>
						<p class="about__text">
							Com sólida formação médica, minha missão é oferecer
							um suporte técnico rigoroso aliado a um olhar
							sensível às suas necessidades individuais. Aqui,
							cada protocolo é desenhado para respeitar o seu
							metabolismo e sua história.
						</p>
					</div>

					<ul class="about__highlights">
						<li class="about__highlight">
							<span class="about__highlight-dot"></span>
							<span class="about__highlight-label"
								>Formação Acadêmica de Excelência</span
							>
						</li>
						<li class="about__highlight">
							<span class="about__highlight-dot"></span>
							<span class="about__highlight-label"
								>Foco em Longevidade e Saúde Hormonal</span
							>
						</li>
						<li class="about__highlight">
							<span class="about__highlight-dot"></span>
							<span class="about__highlight-label"
								>Atendimento Humanizado e Personalizado</span
							>
						</li>
					</ul>
				</div>

				<!-- Lado Visual (Foto) -->
				<div class="about__visual">
					<div class="about__image-frame">
						<img
							src="/images/about-doctor.png"
							alt="Dra. Carolina Mendes — Especialista em Saúde Metabólica"
							class="about__image"
							width="600"
							height="750"
							loading="lazy"
						/>
						<!-- Elementos decorativos premium -->
						<div
							class="about__image-accent about__image-accent--top"
						>
						</div>
						<div
							class="about__image-accent about__image-accent--bottom"
						>
						</div>
					</div>
					<!-- Identificação da Médica -->
					<div class="about__doctor-info">
						<h3 class="about__doctor-name">
							<em>Dra.</em> Carolina Mendes
						</h3>
						<span class="about__doctor-specialty"
							>Emagrecimento & Saúde Metabólica</span
						>
					</div>
				</div>
			</div>

			<!-- Divisor Ondulado About -> Pilares -->
			<div class="wave-divider wave-divider--about">
				<svg
					data-name="Layer 1"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 1200 120"
					preserveAspectRatio="none"
				>
					<path
						d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
						fill="#f8fafc"></path>
				</svg>
			</div>
		</section>

		<!-- ============================================ -->
		<!-- SEÇÃO 05 — Serviços Especializados           -->
		<!-- ============================================ -->
		<section id="servicos" class="servicos">
			<div class="servicos__container">
				<header class="servicos__header">
					<span class="servicos__kicker">Nossas Especialidades</span>
					<h2 class="servicos__title">
						Cuidado completo para sua jornada.
					</h2>
					<p class="servicos__description">
						Tratamentos personalizados com base em evidências
						científicas e foco na sua saúde metabólica.
					</p>
				</header>

				<div class="servicos__grid">
					<!-- Serviço 01 -->
					<div class="servicos__item">
						<div class="servicos__icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<path
									d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</div>
						<div class="servicos__info">
							<h3 class="servicos__name">
								Emagrecimento Saudável
							</h3>
							<p class="servicos__text">
								Perda de peso estratégica com foco na manutenção
								de massa muscular e saúde hormonal.
							</p>
						</div>
					</div>

					<!-- Serviço 02 -->
					<div class="servicos__item">
						<div class="servicos__icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<path
									d="M12 21a9 9 0 100-18 9 9 0 000 18z"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
								<path
									d="M12 8v4l3 3"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</div>
						<div class="servicos__info">
							<h3 class="servicos__name">Saúde Metabólica</h3>
							<p class="servicos__text">
								Tratamento de resistência insulínica, diabetes e
								outros distúrbios que impedem o emagrecimento.
							</p>
						</div>
					</div>

					<!-- Serviço 03 -->
					<div class="servicos__item">
						<div class="servicos__icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<path
									d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 10-7.038 0l-2.387.477a2 2 0 00-1.022.547l-1.07 1.07a2 2 0 00-.547 1.022l-.477 2.387a2 2 0 002.387 2.387l2.387-.477a2 2 0 001.022-.547l1.07-1.07a2 2 0 00.547-1.022l.477-2.387a2 2 0 00-2.387-2.387l-2.387.477a2 2 0 00-1.022.547l-1.07 1.07a2 2 0 00-.547 1.022l-.477 2.387a2 2 0 002.387 2.387l2.387-.477a2 2 0 001.022-.547l1.07-1.07a2 2 0 00.547-1.022l.477-2.387a2 2 0 00-2.387-2.387"
								></path>
							</svg>
						</div>
						<div class="servicos__info">
							<h3 class="servicos__name">Equilíbrio Hormonal</h3>
							<p class="servicos__text">
								Avaliação e reposição hormonal personalizada
								para longevidade e bem-estar.
							</p>
						</div>
					</div>

					<!-- Serviço 04 -->
					<div class="servicos__item">
						<div class="servicos__icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<path
									d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</div>
						<div class="servicos__info">
							<h3 class="servicos__name">
								Bioimpedância Avançada
							</h3>
							<p class="servicos__text">
								Mapeamento preciso da sua gordura corporal,
								massa magra e taxa metabólica basal.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================ -->
		<!-- SEÇÃO 04 — Pilares da Metodologia            -->
		<!-- ============================================ -->
		<section id="pilares" class="pilares">
			<div class="pilares__container">
				<header class="pilares__header">
					<h2 class="pilares__title">
						Como transformamos sua saúde.
					</h2>
				</header>

				<div class="pilares__grid">
					<!-- Card 01 -->
					<div class="pilares__card">
						<div class="pilares__card-icon-wrapper">
							<div class="pilares__card-icon">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
								>
									<path
										d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</div>
						</div>
						<h3 class="pilares__card-title">
							Avaliação Integrativa
						</h3>
						<p class="pilares__card-text">
							Análise profunda de histórico, exames e rotina para
							compreender a causa raiz.
						</p>
					</div>

					<!-- Card 02 -->
					<div class="pilares__card">
						<div class="pilares__card-icon-wrapper">
							<div class="pilares__card-icon">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
								>
									<circle
										cx="12"
										cy="7"
										r="3"
										stroke-linecap="round"
										stroke-linejoin="round"></circle>
									<path
										d="M12 21v-4m-4 4l1-1m7 1l-1-1"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
									<path
										d="M19 15.5c-1.5-1-3.5-1.5-7-1.5s-5.5.5-7 1.5c-1.5 1-2 3-2 5h18c0-2-.5-4-2-5z"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</div>
						</div>
						<h3 class="pilares__card-title">
							Plano Individualizado
						</h3>
						<p class="pilares__card-text">
							Protocolos desenhados exclusivamente para o seu
							perfil metabólico e objetivos específicos.
						</p>
					</div>

					<!-- Card 03 -->
					<div class="pilares__card">
						<div class="pilares__card-icon-wrapper">
							<div class="pilares__card-icon">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
								>
									<path
										d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</div>
						</div>
						<h3 class="pilares__card-title">Suporte Contínuo</h3>
						<p class="pilares__card-text">
							Acompanhamento de perto para ajustes constantes e
							manutenção de resultados sustentáveis.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================ -->
		<!-- SEÇÃO 06 — CTA Parallax (Agendamento)        -->
		<!-- ============================================ -->
		<section class="parallax-cta">
			<div class="parallax-cta__bg" id="parallaxBg"></div>
			<div class="parallax-cta__overlay"></div>
			<div class="parallax-cta__container">
				<h2 class="parallax-cta__title">
					Pronta para transformar sua saúde e recuperar sua
					autoestima?
				</h2>
				<p class="parallax-cta__text">
					Dê o primeiro passo hoje. Agende sua consulta e comece seu
					protocolo personalizado com acompanhamento médico
					especializado.
				</p>
				<div class="parallax-cta__actions">
					<a
						href="https://wa.me/5500000000000?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20minha%20avalia%C3%A7%C3%A3o%20m%C3%A9dica."
						target="_blank"
						rel="noopener noreferrer"
						class="parallax-cta__button"
					>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							width="24"
							height="24"
						>
							<path
								d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.432.178.88.28 1.21.085.33-.198.614-.735.794-.545.18-.99.131-1.29-.069-.297-.149-.57-.347-.708-.57-.546-.09-.347-.297-.198-.56l.016-.03c.18-.313.381-.3.545-.3.164 0 .347.002.496.007.163.006.382-.062.581.44.204.516.694 1.7.752 1.822.059.123.1.267.02.428-.079.16-.119.26-.238.397-.119.138-.249.317-.397.486-.149.168-.306.189-.545.064-.237-.124-1.006-.463-1.912-1.488-.674-.765-1.141-1.712-1.19-2.034-.05-.322.035-.513.262-.676l.042-.046c.198-.215.42-.347.669-.347z"
							></path>
							<path
								d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.96 7.96 0 01-4.108-1.14l-.292-.176-2.848.846.846-2.848-.176-.292A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"
							></path>
						</svg>
						Agendar Minha Consulta Agora
					</a>
				</div>
			</div>
		</section>

		<!-- ============================================ -->
		<!-- SEÇÃO 07 — Prova Social (Depoimentos)        -->
		<!-- ============================================ -->
		<section id="depoimentos" class="testimonials">
			<!-- Divisor Ondulado Parallax -> Testimonials -->
			<div class="wave-divider wave-divider--testimonials">
				<svg
					data-name="Layer 1"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 1200 120"
					preserveAspectRatio="none"
				>
					<path
						d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
						fill="#ffffff"></path>
				</svg>
			</div>

			<div class="testimonials__container">
				<header class="testimonials__header">
					<h2 class="testimonials__title">Transformações Reais</h2>
					<p class="testimonials__subtitle">Histórias de quem recuperou a saúde e a autoestima com nosso acompanhamento.</p>
				</header>

				<div class="testimonials__carousel-container">
					<button class="carousel-btn prev" id="prevBtn" aria-label="Anterior">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</button>

					<div class="testimonials__grid" id="testimonialsGrid">
						<!-- Depoimento 01 -->
						<div class="testimonial-card">
							<div class="testimonial-card__quote">“</div>
							<p class="testimonial-card__text">
								O diferencial foi o acolhimento. Pela primeira vez
								não me senti julgada, mas sim compreendida e tratada
								como um todo.
							</p>
							<div class="testimonial-card__author">
								<span class="testimonial-card__name"
									>Ana Paula S.</span
								>
								<span class="testimonial-card__meta"
									>Paciente há 6 meses</span
								>
							</div>
						</div>

						<!-- Depoimento 02 -->
						<div class="testimonial-card">
							<div class="testimonial-card__quote">“</div>
							<p class="testimonial-card__text">
								Resultados sustentáveis que nunca consegui com
								dietas da moda. O acompanhamento médico mudou minha
								relação com a comida.
							</p>
							<div class="testimonial-card__author">
								<span class="testimonial-card__name"
									>Mariana L.</span
								>
								<span class="testimonial-card__meta"
									>Eliminou 12kg</span
								>
							</div>
						</div>

						<!-- Depoimento 03 -->
						<div class="testimonial-card">
							<div class="testimonial-card__quote">“</div>
							<p class="testimonial-card__text">
								Muito mais que perda de peso, recuperei minha
								energia e disposição diária. Recomendo de olhos
