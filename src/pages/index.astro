		<script>
			const loadMoreBtn = document.getElementById('loadMoreBtn');
			const extraTestimonials = document.querySelectorAll('.extra-testimonial');
			const testimonialsGrid = document.getElementById('testimonialsGrid');
			const prevBtn = document.getElementById('prevBtn');
			const nextBtn = document.getElementById('nextBtn');

			if (prevBtn && nextBtn && testimonialsGrid) {
				const scrollAmount = 400;

				nextBtn.addEventListener('click', () => {
					const maxScroll = testimonialsGrid.scrollWidth - testimonialsGrid.clientWidth;
					if (testimonialsGrid.scrollLeft >= maxScroll - 10) {
						testimonialsGrid.scrollTo({ left: 0, behavior: 'smooth' });
					} else {
						testimonialsGrid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
					}
				});

				prevBtn.addEventListener('click', () => {
					if (testimonialsGrid.scrollLeft <= 10) {
						const maxScroll = testimonialsGrid.scrollWidth - testimonialsGrid.clientWidth;
						testimonialsGrid.scrollTo({ left: maxScroll, behavior: 'smooth' });
					} else {
						testimonialsGrid.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
					}
				});
			}

			// Parallax Vertical Script
			const parallaxBg = document.getElementById('parallaxBg');
			if (parallaxBg) {
				window.addEventListener('scroll', () => {
					const scrollValue = window.scrollY;
					const section = parallaxBg.parentElement;
					const sectionTop = section.offsetTop;
					const sectionHeight = section.offsetHeight;
					const windowHeight = window.innerHeight;

					// Verifica se a seção está visível
					if (scrollValue + windowHeight > sectionTop && scrollValue < sectionTop + sectionHeight) {
						const relativeScroll = scrollValue - sectionTop;
						// Ajusta o translateY para o efeito parallax vertical
						// Mantemos a animação horizontal do CSS separada
						parallaxBg.style.top = `calc(-20% + ${relativeScroll * 0.15}px)`;
					}
				});
			}
		</script>
