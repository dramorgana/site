---
import Layout from "../../layouts/Layout.astro";
import BlogPageSection from "../../components/BlogSection/BlogPageSection.astro";
import Footer from "../../components/Footer/Footer.astro";

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://drmorganamota.com.br",
);
---

<Layout
  title="Blog | Dra. Morgana Motta - Saúde Metabólica e Emagrecimento"
  description="Artigos e novidades sobre saúde metabólica, nutrição e emagrecimento consciente escritos pela Dra. Morgana Motta."
>
  <head slot="head">
    <link rel="canonical" href={canonicalURL} />
  </head>
  <main style="padding-top: 80px;">
    <BlogPageSection showHero={true} showCategoryBlocks={true} />
  </main>
  <Footer />
</Layout>
