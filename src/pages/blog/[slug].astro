---
import Layout from "../../layouts/Layout.astro";
import { PortableText } from "astro-portabletext";
import Footer from "../../components/Footer/Footer.astro";
import { sanityClient, urlFor } from "../../lib/sanity";
import "../../styles/post.css";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post"]{ "slug": slug.current }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;

// Buscamos o post específico do Sanity
const postSanity = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug][0] {
    title,
    description,
    publishedAt,
    "category": categories[0]->title,
    mainImage,
    "authorName": author->name,
    "authorCrm": author->crm,
    "authorImage": author->image,
    body
  }
`, { slug });

const DEFAULT_IMAGE = "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&q=80&w=800";

const post = {
  ...postSanity,
  image: postSanity.mainImage ? urlFor(postSanity.mainImage).width(1200).url() : DEFAULT_IMAGE,
  description: postSanity.description || "Leia mais sobre este assunto em nosso blog completo.",
  date: new Date(postSanity.publishedAt || new Date()).toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).replace('.', ''),
  author: postSanity.authorName || "Dra. Carolina Mendes",
  authorCrm: postSanity.authorCrm || "CRM-SP 123456",
  seoDescription: postSanity.description || "Artigo sobre saúde e bem-estar pela Dra. Carolina Mendes."
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dracarolinamendes.com.br');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.seoDescription,
  "image": post.image,
  "datePublished": post.publishedAt,
  "author": {
    "@type": "Person",
    "name": post.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dra. Carolina Mendes",
    "logo": {
      "@type": "ImageObject",
      "url": "/favicon.svg"
    }
  }
};
---

<Layout 
  title={`${post.title} | Blog Dra. Carolina Mendes`}
  description={post.seoDescription}
>
  <head slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.seoDescription} />
    <meta property="og:image" content={post.image} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <main>
    <article class="post-container">
      <header class="post-header">
        <span class="post-category">{post.category}</span>
        <h1 class="post-title">{post.title}</h1>
        <div class="post-meta">
          <span>{post.date}</span>
          <span>•</span>
          <span>Por {post.author}</span>
          <span class="post-author-crm">({post.authorCrm})</span>
        </div>
      </header>

      <img src={post.image} alt={post.title} class="post-hero-image" />

      <div class="post-content">
        {post.body ? <PortableText value={post.body} /> : <p>{post.description}</p>}
      </div>

      <footer class="post-footer">
        <a href="/blog" class="back-to-blog">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Voltar para o Blog
        </a>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>
