---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { PortableText } from "astro-portabletext";
import PortableTextImage from "../../components/BlogSection/PortableTextImage.astro";
import PortableTextHeading from "../../components/BlogSection/PortableTextHeading.astro";
import PortableTextTable from "../../components/BlogSection/PortableTextTable.astro";
import Footer from "../../components/Footer/Footer.astro";
import { sanityClient, urlFor, getSanityImageAttrs } from "../../lib/sanity";
import { fallbackPosts } from "../../components/BlogSection/fallbackPosts";
import doctorAvatar from "../../assets/About/about-doctor-foto04.jpg";
import "../../styles/post.css";

export async function getStaticPaths() {
  const sanityPosts = await sanityClient
    .fetch(`*[_type == "post"]{ "slug": slug.current }`)
    .catch(() => []);
  const slugs = new Set<string>([
    ...sanityPosts.map((p: any) => p.slug).filter(Boolean),
    ...fallbackPosts.map((p) => p.slug),
  ]);
  return Array.from(slugs).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

const postSanity = await sanityClient
  .fetch(
    `
  *[_type == "post" && slug.current == $slug][0] {
    title,
    description,
    summary,
    publishedAt,
    updatedAt,
    medicalReviewedAt,
    readTime,
    category,
    excerpt,
    "excerptText": pt::text(excerpt),
    content[] {
      ...,
      _type == "image" => {
        ...,
        asset-> { _id, originalFilename, metadata { dimensions } }
      }
    },
    image {
      ...,
      asset-> { _id, originalFilename, metadata { dimensions } }
    },
    "imageAlt": image.alt,
    cta {
      title,
      description
    },
    faq,
    references,
    disclaimer,
    author-> {
      name,
      crm,
      specialty,
      jobTitle,
      url,
      image,
      "bio": pt::text(bio)
    },
    "seo": coalesce(
      seo-> {
        metaTitle,
        metaDescription,
        canonicalUrl,
        noIndex,
        ogTitle,
        ogDescription,
        ogImage,
        sectionCategory,
        keywords,
        reviewerName,
        inLanguage
      },
      seo {
        metaTitle,
        metaDescription,
        canonicalUrl,
        noIndex,
        ogTitle,
        ogDescription,
        ogImage,
        sectionCategory,
        keywords,
        reviewerName,
        inLanguage
      }
    )
  }
`,
    { slug },
  )
  .catch(() => null);

const fallback = fallbackPosts.find((p) => p.slug === slug);
const rawPost = postSanity || fallback || fallbackPosts[0];

const DEFAULT_IMAGE =
  "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&q=80&w=800";

const rawBody: any[] = Array.isArray(rawPost.content)
  ? rawPost.content
  : Array.isArray(rawPost.body)
    ? rawPost.body
    : [];
const excerptBlocks: any[] = Array.isArray(rawPost.excerpt)
  ? rawPost.excerpt
  : [];
const faqItems: any[] = Array.isArray(rawPost.faq) ? rawPost.faq : [];
const referenceBlocks: any[] = Array.isArray(rawPost.references)
  ? rawPost.references
  : [];

const blocksToPlainText = (blocks: any[]): string =>
  (blocks || [])
    .filter((b) => b?._type === "block")
    .map((b) => (b.children || []).map((c: any) => c.text || "").join(""))
    .join(" ")
    .replace(/\s+/g, " ")
    .trim();

// Remove o bloco manual "Índice" e sua lista imediata, pois o Sumário já é exibido na barra lateral
const bodyBlocks: any[] = [];
let skippingIndexList = false;
for (const block of rawBody) {
  const text =
    block?._type === "block"
      ? (block.children || [])
          .map((c: any) => c.text || "")
          .join("")
          .trim()
      : "";

  if (
    block?._type === "block" &&
    block.style === "h2" &&
    /^índice$/i.test(text)
  ) {
    skippingIndexList = true;
    continue;
  }
  if (skippingIndexList) {
    if (block?._type === "block" && block.listItem) {
      continue;
    }
    skippingIndexList = false;
  }
  bodyBlocks.push(block);
}

// Extrai os tópicos (h2) para o Sumário
const slugify = (str: string) =>
  str
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const tocItems = bodyBlocks
  .filter((b) => b?._type === "block" && (b.style === "h2" || b.style === "h1"))
  .map((b) => {
    const label = (b.children || [])
      .map((c: any) => c.text || "")
      .join("")
      .trim();
    return { id: slugify(label), label };
  })
  .filter((item) => item.label && item.id);

// Calcula tempo estimado de leitura
const totalWords = bodyBlocks.reduce((acc, b) => {
  if (b?._type === "block") {
    const t = (b.children || []).map((c: any) => c.text || "").join(" ");
    return acc + t.split(/\s+/).filter(Boolean).length;
  }
  return acc;
}, 0);
const readingMinutes = Math.max(1, Math.ceil(totalWords / 200));

const formatPtBrDate = (value?: string) =>
  value
    ? new Date(value).toLocaleDateString("pt-BR", {
        day: "2-digit",
        month: "long",
        year: "numeric",
      })
    : null;

const postImageSource = postSanity?.image || postSanity?.mainImage;
const rawKeywords = rawPost.seo?.keywords;
const parsedKeywords: string[] = Array.isArray(rawKeywords)
  ? rawKeywords.filter(Boolean)
  : typeof rawKeywords === "string"
    ? rawKeywords
        .split(",")
        .map((k: string) => k.trim())
        .filter(Boolean)
    : [];

const primaryCategory =
  (Array.isArray(rawPost.category) ? rawPost.category[0] : rawPost.category) ||
  "Saúde Metabólica";
const categoriesList: string[] = Array.isArray(rawPost.category)
  ? rawPost.category.filter(Boolean)
  : [primaryCategory];

const fallbackSummary =
  rawPost.excerptText ||
  rawPost.description ||
  "Leia mais sobre este assunto em nosso blog completo.";

const heroImageAttrs = getSanityImageAttrs(postImageSource, 1200, slug);

const post = {
  ...rawPost,
  image: heroImageAttrs?.src || fallback?.image || DEFAULT_IMAGE,
  imageWidth: heroImageAttrs?.width,
  imageHeight: heroImageAttrs?.height,
  imageAlt: rawPost.imageAlt || rawPost.mainImageAlt || rawPost.title,
  description: fallbackSummary,
  disclaimer:
    rawPost.disclaimer ||
    "Este conteúdo possui caráter meramente educativo e informativo. Não substitui consulta médica. Agende uma avaliação médica para orientação individualizada sobre o seu caso.",
  date: formatPtBrDate(rawPost.publishedAt || new Date().toISOString())!,
  updatedDate: formatPtBrDate(rawPost.updatedAt),
  medicalReviewedDate: formatPtBrDate(rawPost.medicalReviewedAt),
  readTimeLabel: rawPost.readTime || `${readingMinutes} min`,
  author: rawPost.author?.name || rawPost.authorName || "Dra. Morgana Motta",
  reviewer:
    rawPost.seo?.reviewerName ||
    rawPost.author?.name ||
    rawPost.authorName ||
    "Dra. Morgana Motta",
  authorCrm: rawPost.author?.crm || rawPost.authorCrm || "CRM-MG 96204",
  authorSpecialty:
    rawPost.author?.specialty ||
    rawPost.authorSpecialty ||
    "Médica • Emagrecimento e Ganho de Massa Muscular",
  authorJobTitle: rawPost.author?.jobTitle || "Médica",
  authorUrl:
    rawPost.author?.url || "https://www.dramorganamotta.com.br/#about",
  authorImage: rawPost.author?.image
    ? urlFor(rawPost.author.image).width(240).height(240).fit("crop").url()
    : null,
  authorBio:
    rawPost.author?.bio ||
    rawPost.authorBio ||
    "Médica formada pela Faculdade Ciências Médicas de Minas Gerais, pós-graduada em Urgência e Emergência pela Faculdade Albert Einstein. Atende no Instituto Bernardo Guimarães, em Belo Horizonte, com foco em emagrecimento e ganho de massa muscular.",
  category: primaryCategory,
  categories: categoriesList,
  ctaTitle:
    rawPost.cta?.title ||
    rawPost.ctaTitle ||
    "Quer uma avaliação individualizada para o seu caso?",
  ctaDescription:
    rawPost.cta?.description ||
    rawPost.ctaDescription ||
    "Agende uma consulta com a Dra. Morgana Motta para investigar seu metabolismo, rotina, exames e traçar um plano feito sob medida para você.",
  seoTitle:
    rawPost.seo?.metaTitle || `${rawPost.title} | Blog Dra. Morgana Motta`,
  seoDescription:
    rawPost.seo?.metaDescription ||
    fallbackSummary ||
    "Artigo sobre saúde e bem-estar pela Dra. Morgana Motta.",
  seoOgTitle:
    rawPost.seo?.ogTitle ||
    rawPost.seo?.metaTitle ||
    `${rawPost.title} | Blog Dra. Morgana Motta`,
  seoOgDescription:
    rawPost.seo?.ogDescription ||
    rawPost.seo?.metaDescription ||
    fallbackSummary,
  seoSection: rawPost.seo?.sectionCategory || primaryCategory,
  seoInLanguage: rawPost.seo?.inLanguage || "pt-BR",
  seoKeywords: parsedKeywords,
  seoOgImage: rawPost.seo?.ogImage
    ? urlFor(rawPost.seo.ogImage).width(1200).height(630).fit("crop").url()
    : postImageSource
      ? urlFor(postImageSource).width(1200).url()
      : fallback?.image || DEFAULT_IMAGE,
  seoNoIndex: Boolean(rawPost.seo?.noIndex),
};

const canonicalURL =
  rawPost.seo?.canonicalUrl ||
  new URL(
    Astro.url.pathname,
    Astro.site || "https://www.dramorganamotta.com.br",
  ).toString();

const whatsappUrl =
  "https://wa.me/5531989067668?text=" +
  encodeURIComponent(
    `Olá Dra. Morgana, li o artigo "${post.title}" e gostaria de agendar uma avaliação.`,
  );

const siteOrigin = (
  Astro.site?.toString() || "https://www.dramorganamotta.com.br"
).replace(/\/$/, "");

const effectiveModifiedAt = post.updatedAt || post.publishedAt;
const effectiveReviewedAt =
  post.medicalReviewedAt || post.updatedAt || post.publishedAt;

const schemaData: Record<string, any> = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Início",
          item: `${siteOrigin}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: `${siteOrigin}/blog`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.title,
        },
      ],
    },
    {
      "@type": ["MedicalWebPage", "BlogPosting"],
      headline: post.title,
      description: post.seoDescription,
      image: post.seoOgImage,
      mainEntityOfPage: canonicalURL,
      ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
      ...(effectiveModifiedAt ? { dateModified: effectiveModifiedAt } : {}),
      ...(effectiveReviewedAt ? { lastReviewed: effectiveReviewedAt } : {}),
      inLanguage: post.seoInLanguage,
      articleSection: post.seoSection,
      author: {
        "@type": "Person",
        name: post.author,
        jobTitle: post.authorJobTitle,
        identifier: post.authorCrm,
        url: post.authorUrl,
      },
      reviewedBy: {
        "@type": "Person",
        name: post.reviewer,
      },
      publisher: {
        "@type": "Organization",
        name: "Dra. Morgana Motta",
        logo: {
          "@type": "ImageObject",
          url: `${siteOrigin}/favicon.svg`,
        },
      },
    },
  ],
};

const faqMainEntity = faqItems
  .filter((item) => item?.question && Array.isArray(item?.answer))
  .map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: blocksToPlainText(item.answer),
    },
  }))
  .filter((q) => q.acceptedAnswer.text);

const faqSchemaData =
  faqMainEntity.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqMainEntity,
      }
    : null;
---

<Layout
  title={post.seoTitle}
  description={post.seoDescription}
  ogTitle={post.seoOgTitle}
  ogDescription={post.seoOgDescription}
  ogImage={post.seoOgImage}
  canonicalURL={canonicalURL}
  ogType="article"
  keywords={post.seoKeywords}
  noIndex={post.seoNoIndex}
>
  <Fragment slot="head">
    {post.publishedAt && (
      <meta property="article:published_time" content={post.publishedAt} />
    )}
    {post.updatedAt && (
      <meta property="article:modified_time" content={post.updatedAt} />
    )}
    <meta property="article:section" content={post.seoSection} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    {faqSchemaData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(faqSchemaData)}
      />
    )}
  </Fragment>

  <main class="post-page">
    <!-- Cabeçalho do Artigo -->
    <header class="post-header">
      <div class="post-topbar">
        <nav aria-label="Breadcrumb" class="post-breadcrumb">
          <ol>
            <li>
              <a href="/">
                <svg
                  viewBox="0 0 24 24"
                  width="15"
                  height="15"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
                  <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                </svg>
                <span>Início</span>
              </a>
            </li>
            <li class="post-breadcrumb__sep" aria-hidden="true">
              ›
            </li>
            <li>
              <a href="/blog">Blog</a>
            </li>
            <li class="post-breadcrumb__sep" aria-hidden="true">
              ›
            </li>
            <li class="post-breadcrumb__current" aria-current="page">
              <span>{post.title}</span>
            </li>
          </ol>
        </nav>

        <a href="/blog" class="post-back-btn">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
          </svg>
          <span>Voltar para o blog</span>
        </a>
      </div>

      <span class="post-category">{post.category}</span>

      <h1 class="post-title">{post.title}</h1>

      <!-- Card Resumo / Destaque Inicial -->
      <div class="post-summary-card">
        <div class="post-summary-card__bar" aria-hidden="true"></div>
        <div class="post-summary-card__inner">
          <div class="post-summary-card__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
            </svg>
          </div>
          <div>
            <span class="post-summary-card__label">Resumo do artigo</span>
            <p class="post-summary-card__text">{post.summary}</p>
            <div class="post-summary-card__text">
              {excerptBlocks.length > 0 ? (
                <PortableText
                  value={excerptBlocks}
                  components={{
                    type: { image: PortableTextImage },
                  }}
                />
              ) : (
                <p>{post.description}</p>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de Autor e Metadados -->
      <div class="post-author-bar">
        <div class="post-author-bar__profile">
          <div class="post-author-bar__avatar">
            {post.authorImage ? (
              <img
                src={post.authorImage}
                alt={post.author}
                width="64"
                height="64"
                loading="eager"
              />
            ) : (
              <Image
                src={doctorAvatar}
                alt={post.author}
                width={64}
                height={64}
              />
            )}
          </div>
          <div class="post-author-bar__info">
            <p class="post-author-bar__name">{post.author}</p>
            <p class="post-author-bar__role">
              {post.authorSpecialty} • {post.authorCrm}
            </p>
          </div>
        </div>

        <div class="post-author-bar__meta">
          <div class="post-reading-time">
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>{post.readTimeLabel} min de leitura</span>
          </div>
          <p class="post-published-date">
            Publicado em <time datetime={rawPost.publishedAt}>{post.date}</time>
          </p>
          {post.updatedDate && (
            <p class="post-updated-date">
              Atualizado em{" "}
              <time datetime={rawPost.updatedAt}>{post.updatedDate}</time>
            </p>
          )}
          {post.medicalReviewedDate && (
            <p class="post-reviewed-date">
              Revisão médica em{" "}
              <time datetime={rawPost.medicalReviewedAt}>
                {post.medicalReviewedDate}
              </time>
            </p>
          )}
        </div>
      </div>
    </header>

    <!-- Imagem de Capa -->
    <figure class="post-hero-figure">
      <div class="post-hero-image-wrap">
        <img
          src={post.image}
          alt={post.imageAlt}
          width={post.imageWidth}
          height={post.imageHeight}
          class="post-hero-image"
          loading="eager"
        />
      </div>
    </figure>

    <!-- Aviso Médico -->
    <div class="post-disclaimer">
      <strong>Aviso médico:</strong> {post.disclaimer}
    </div>

    <!-- Sumário Mobile (colapsável) -->
    {tocItems.length > 0 && (
      <details class="post-toc-mobile">
        <summary class="post-toc__header">
          <span class="post-toc__title">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            Sumário do artigo
          </span>
          <span class="post-toc__chevron" aria-hidden="true">
            ▾
          </span>
        </summary>
        <nav aria-label="Sumário do artigo" class="post-toc__list-wrap">
          <ol class="post-toc__list">
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}

    <!-- Grid Principal: Sumário Lateral (4 cols) + Conteúdo (8 cols) -->
    <div class="post-grid">
      {tocItems.length > 0 && (
        <aside class="post-sidebar">
          <div class="post-toc-card">
            <div class="post-toc__header">
              <span class="post-toc__title">
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="8" y1="6" x2="21" y2="6" />
                  <line x1="8" y1="12" x2="21" y2="12" />
                  <line x1="8" y1="18" x2="21" y2="18" />
                  <line x1="3" y1="6" x2="3.01" y2="6" />
                  <line x1="3" y1="12" x2="3.01" y2="12" />
                  <line x1="3" y1="18" x2="3.01" y2="18" />
                </svg>
                Sumário do artigo
              </span>
            </div>
            <nav aria-label="Sumário do artigo" class="post-toc__list-wrap">
              <ol class="post-toc__list">
                {tocItems.map((item) => (
                  <li>
                    <a href={`#${item.id}`}>{item.label}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        </aside>
      )}

      <div class="post-main-col">
        <article class="post-content">
          {bodyBlocks.length > 0 ? (
            <PortableText
              value={bodyBlocks}
              components={{
                type: { image: PortableTextImage, tableBlock: PortableTextTable },
                block: {
                  h2: PortableTextHeading,
                  h3: PortableTextHeading,
                },
              }}
            />
          ) : (
            <p>{post.description}</p>
          )}
        </article>

        <!-- Perguntas Frequentes (FAQ) -->
        {faqItems.length > 0 && (
          <section class="post-faq" aria-label="Perguntas Frequentes">
            <h2 class="post-section-heading">Perguntas Frequentes</h2>
            <div class="post-faq__list">
              {faqItems.map((item) => (
                <details class="post-faq__item">
                  <summary class="post-faq__question">
                    <span>{item.question}</span>
                    <span class="post-faq__chevron" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <div class="post-faq__answer">
                    <PortableText value={item.answer} />
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Referências Bibliográficas -->
        {referenceBlocks.length > 0 && (
          <section
            class="post-references"
            aria-label="Referências Bibliográficas"
          >
            <h2 class="post-section-heading">Referências Bibliográficas</h2>
            <div class="post-references__body">
              <PortableText value={referenceBlocks} />
            </div>
          </section>
        )}

        <!-- Card da Autora ao Final -->
        <section class="post-author-card" aria-label="Sobre a autora">
          <div class="post-author-card__avatar">
            {post.authorImage ? (
              <img
                src={post.authorImage}
                alt={post.author}
                width="96"
                height="96"
                loading="lazy"
              />
            ) : (
              <Image
                src={doctorAvatar}
                alt={post.author}
                width={96}
                height={96}
              />
            )}
          </div>
          <div class="post-author-card__body">
            <span class="post-author-card__kicker">Escrito por</span>
            <h3 class="post-author-card__name">{post.author}</h3>
            <p class="post-author-card__crm">{post.authorCrm}</p>
            <p class="post-author-card__desc">{post.authorBio}</p>
          </div>
        </section>

        <!-- Card CTA de Agendamento -->
        <section id="agendamento" class="post-cta-card">
          <div class="post-cta-card__glow" aria-hidden="true"></div>
          <div class="post-cta-card__content">
            <h3 class="post-cta-card__title">{post.ctaTitle}</h3>
            <p class="post-cta-card__text">{post.ctaDescription}</p>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="post-cta-card__btn"
            >
              Agendar Minha Avaliação
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
