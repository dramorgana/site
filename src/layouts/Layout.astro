---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Emagrecimento guiado pela ciência, focado na sua saúde. Acompanhamento médico individualizado que respeita o seu metabolismo." } = Astro.props;

// Schema.org Data
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "name": "Dra. Especialista — Emagrecimento e Saúde Metabólica",
  "description": description,
  "url": Astro.url,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "São Paulo",
    "addressRegion": "SP",
    "addressCountry": "BR"
  },
  "medicalSpecialty": "Endocrinology"
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Preconnect to Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

		<!-- SEO / Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* === Global Reset & Base === */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		font-family: var(--font-body);
		background-color: var(--color-alabaster);
		color: var(--color-body-text);
		line-height: 1.7;
		overflow-x: hidden;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-heading);
		color: var(--color-dark-text);
		line-height: 1.15;
	}

	::selection {
		background-color: rgba(163, 184, 153, 0.25);
		color: var(--color-dark-text);
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	a {
		text-decoration: none;
		color: inherit;
	}
</style>
