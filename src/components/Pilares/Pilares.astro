---
import { content } from './data';
---

<section id="pilares" class="pilares">
	<div class="pilares__container">
		<header class="pilares__header">
			<p class="pilares__intro">{content.intro}</p>
			<h2 class="pilares__title">{content.title}</h2>
		</header>
		
		<div class="pilares__grid">
			{
				content.pillars.map((pillar, index) => (
					<div class="pilares__card">
						<span class="pilares__number">0{index + 1}</span>
						<div class="pilares__card-content">
							<div class="pilares__icon">
								{pillar.icon === "doc" && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
										<path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
								{pillar.icon === "user" && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
										<circle cx="12" cy="7" r="3" stroke-linecap="round" stroke-linejoin="round" />
										<path d="M12 21v-4m-4 4l1-1m7 1l-1-1" stroke-linecap="round" stroke-linejoin="round" />
										<path d="M19 15.5c-1.5-1-3.5-1.5-7-1.5s-5.5.5-7 1.5c-1.5 1-2 3-2 5h18c0-2-.5-4-2-5z" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
								{pillar.icon === "heart" && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
										<path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
							</div>
							<h3 class="pilares__card-title">{pillar.title}</h3>
							<p class="pilares__card-text">{pillar.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	/* ============================================
	   PILARES — Minimalist & Elegant Redesign
	   ============================================ */
	.pilares {
		padding: 160px 24px;
		background-color: var(--color-alabaster);
		position: relative;
		overflow: hidden;
	}

	.pilares__container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.pilares__header {
		text-align: center;
		margin-bottom: 100px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
	}

	.pilares__intro {
		font-family: var(--font-body);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-sage);
		font-weight: 600;
		max-width: 600px;
	}

	.pilares__title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		color: var(--color-dark-text);
		line-height: 1.1;
		font-weight: 400;
	}

	/* --- Grid Layout --- */
	.pilares__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 40px;
		position: relative;
	}

	/* Connecting line (Desktop only) */
	@media (min-width: 1025px) {
		.pilares__grid::before {
			content: "";
			position: absolute;
			top: 50%;
			left: 10%;
			right: 10%;
			height: 1px;
			background: linear-gradient(to right, transparent, var(--color-sage-light), transparent);
			z-index: 0;
			opacity: 0.5;
		}
	}

	.pilares__card {
		position: relative;
		padding: 60px 40px;
		background: #ffffff;
		border-radius: 40px;
		transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
		z-index: 1;
		border: 1px solid rgba(0, 155, 77, 0.05);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.pilares__card:hover {
		transform: translateY(-15px);
		box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.08);
		border-color: var(--color-sage-light);
	}

	.pilares__number {
		position: absolute;
		top: 20px;
		right: 40px;
		font-family: var(--font-heading);
		font-size: 5rem;
		font-weight: 700;
		color: var(--color-sage);
		opacity: 0.05;
		user-select: none;
		line-height: 1;
	}

	.pilares__icon {
		width: 80px;
		height: 80px;
		background: rgba(0, 155, 77, 0.03);
		color: var(--color-sage);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 32px;
		transition: all 0.3s ease;
	}

	.pilares__card:hover .pilares__icon {
		background: var(--color-sage);
		color: #ffffff;
		transform: scale(1.1);
	}

	.pilares__icon svg {
		width: 32px;
		height: 32px;
	}

	.pilares__card-title {
		font-family: var(--font-heading);
		font-size: 1.8rem;
		color: var(--color-dark-text);
		margin-bottom: 20px;
		font-weight: 500;
	}

	.pilares__card-text {
		font-family: var(--font-body);
		font-size: 1.1rem;
		color: var(--color-body-text);
		line-height: 1.6;
		opacity: 0.85;
	}

	/* --- Responsive --- */
	@media (max-width: 1024px) {
		.pilares {
			padding: 100px 24px;
		}

		.pilares__grid {
			grid-template-columns: 1fr;
			max-width: 500px;
			margin: 0 auto;
			gap: 40px;
		}

		.pilares__card {
			padding: 50px 30px;
		}

		.pilares__number {
			font-size: 4rem;
			right: 30px;
		}
	}
</style>
