---
import { content } from "./data";
import SectionHeader from "../SectionHeader/SectionHeader.astro";
import "./styles.css";
---

<section id="pilares" class="pilares">
	<div class="pilares__container">
		<SectionHeader
			kicker={content.intro}
			title={content.title}
			description={content.description}
			centered={true}
		/>

		<div class="pilares__grid">
			{
				content.pillars.map((pillar, index) => (
					<div class="pilares__card">
						<span class="pilares__number">0{index + 1}</span>
						<div class="pilares__card-content">
							<div class="pilares__icon">
								{pillar.icon === "doc" && (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.2"
									>
										<path
											d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
								{pillar.icon === "user" && (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.2"
									>
										<circle
											cx="12"
											cy="7"
											r="3"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
										<path
											d="M12 21v-4m-4 4l1-1m7 1l-1-1"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
										<path
											d="M19 15.5c-1.5-1-3.5-1.5-7-1.5s-5.5.5-7 1.5c-1.5 1-2 3-2 5h18c0-2-.5-4-2-5z"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
								{pillar.icon === "heart" && (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.2"
									>
										<path
											d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
							</div>
							<h3 class="pilares__card-title">{pillar.title}</h3>
							<p class="pilares__card-text">{pillar.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
