---
import { content } from './data';
---

<section id="about" class="about">
	<div class="about__container">
		<!-- Lado do Conteúdo -->
		<div class="about__content">
			<header class="about__header">
				<span class="about__kicker">{content.kicker}</span>
				<h2 class="about__title">{content.title}</h2>
				<div class="about__divider"></div>
			</header>

			<div class="about__body">
				{
					content.paragraphs.map((text) => (
						<p class="about__text">{text}</p>
					))
				}
			</div>

			<ul class="about__highlights">
				{
					content.highlights.map((label) => (
						<li class="about__highlight">
							<span class="about__highlight-dot" />
							<span class="about__highlight-label">{label}</span>
						</li>
					))
				}
			</ul>
		</div>

		<!-- Lado Visual (Foto) -->
		<div class="about__visual">
			<div class="about__image-frame">
				<img
					src={content.image.src}
					alt={content.image.alt}
					class="about__image"
					width={content.image.width}
					height={content.image.height}
					loading="lazy"
				/>
				<!-- Elementos decorativos premium -->
				<div class="about__image-accent about__image-accent--top"></div>
				<div
					class="about__image-accent about__image-accent--bottom"
				>
				</div>
			</div>
			<!-- Identificação da Médica -->
			<div class="about__doctor-info">
				<h3 class="about__doctor-name">
					<em>{content.doctor.prefix}</em>
					{content.doctor.name}
				</h3>
				<span class="about__doctor-specialty">
					{content.doctor.specialty}
				</span>
			</div>
		</div>
	</div>

	<!-- Divisor Ondulado About -> Pilares -->
	<div class="wave-divider wave-divider--about">
		<svg
			data-name="Layer 1"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1200 120"
			preserveAspectRatio="none"
		>
			<path
				d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
				fill="#f8fafc"></path>
		</svg>
	</div>
</section>

<style>
	/* ============================================
	   ABOUT — Design System
	   ============================================ */
	.about {
		padding: 140px 24px;
		background: linear-gradient(
			135deg,
			var(--color-alabaster) 0%,
			rgba(212, 196, 183, 0.15) 100%
		);
		position: relative;
		overflow: hidden;
	}

	.about::before,
	.about::after {
		content: "";
		position: absolute;
		border-radius: 50%;
		filter: blur(120px);
		z-index: 0;
		opacity: 0.5;
		pointer-events: none;
		animation: aboutBlobFloat 25s infinite alternate ease-in-out;
	}

	.about::before {
		width: 500px;
		height: 500px;
		background: #b8cbb0;
		top: -150px;
		right: -100px;
	}

	.about::after {
		width: 450px;
		height: 450px;
		background: #e3d5c8;
		bottom: -100px;
		left: -150px;
		animation-delay: -10s;
	}

	@keyframes aboutBlobFloat {
		from {
			transform: translate(0, 0) rotate(0deg) scale(1);
		}
		to {
			transform: translate(60px, 40px) rotate(15deg) scale(1.1);
		}
	}

	.about__container {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 80px;
		align-items: center;
		position: relative;
		z-index: 1;
	}

	/* --- Content --- */
	.about__kicker {
		display: block;
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-sage);
		margin-bottom: 20px;
	}

	.about__title {
		font-family: var(--font-heading);
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.15;
		color: var(--color-dark-text);
		margin-bottom: 32px;
	}

	.about__divider {
		width: 60px;
		height: 2px;
		background-color: var(--color-sand);
		margin-bottom: 40px;
	}

	.about__body {
		margin-bottom: 48px;
	}

	.about__text {
		font-family: var(--font-body);
		font-size: 1.1rem;
		color: var(--color-body-text);
		margin-bottom: 24px;
		max-width: 540px;
	}

	.about__highlights {
		list-style: none;
		display: grid;
		gap: 16px;
	}

	.about__highlight {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.about__highlight-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--color-sage);
		flex-shrink: 0;
	}

	.about__highlight-label {
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-dark-text);
		letter-spacing: 0.02em;
	}

	/* --- Visual --- */
	.about__visual {
		position: relative;
	}

	.about__image-frame {
		position: relative;
		padding: 20px;
	}

	.about__image {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 20px;
		box-shadow: 0 40px 80px -20px rgba(45, 58, 54, 0.15);
		position: relative;
		z-index: 2;
	}

	.about__image-accent {
		position: absolute;
		width: 140px;
		height: 140px;
		border: 1px solid var(--color-sand);
		z-index: 1;
		border-radius: 12px;
	}

	.about__image-accent--top {
		top: 0;
		right: 0;
		transform: translate(20px, -20px);
	}

	.about__image-accent--bottom {
		bottom: 0;
		left: 0;
		transform: translate(-20px, 20px);
		background-color: rgba(212, 196, 183, 0.1);
	}

	.about__doctor-info {
		margin-top: 40px;
		text-align: center;
	}

	.about__doctor-name {
		font-family: var(--font-heading);
		font-size: clamp(1.4rem, 4vw, 1.8rem);
		font-weight: 500;
		letter-spacing: 0.05em;
		color: var(--color-dark-text);
		margin-bottom: 8px;
	}

	.about__doctor-name em {
		font-style: italic;
		font-weight: 400;
		opacity: 0.8;
		margin-right: 4px;
	}

	.about__doctor-specialty {
		display: block;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.35em;
		text-transform: uppercase;
		color: var(--color-sage);
		margin-top: 12px;
	}

	/* --- Wave Divider Specific --- */
	.wave-divider {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		overflow: hidden;
		line-height: 0;
		transform: rotate(180deg);
		z-index: 10;
	}

	.wave-divider svg {
		position: relative;
		display: block;
		width: calc(100% + 1.3px);
		height: 80px;
		filter: drop-shadow(0 -10px 15px rgba(0, 0, 0, 0.08));
	}

	.wave-divider--about svg {
		filter: drop-shadow(0 -15px 20px rgba(0, 0, 0, 0.1));
	}

	.wave-divider--about {
		bottom: -1px;
	}

	/* ============================================
	   RESPONSIVE ABOUT
	   ============================================ */
	@media (max-width: 992px) {
		.about {
			padding: 80px 24px;
		}

		.about__container {
			grid-template-columns: 1fr;
			gap: 60px;
		}

		.about__content {
			order: 1;
			text-align: center;
		}

		.about__header {
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.about__text {
			margin-left: auto;
			margin-right: auto;
		}

		.about__highlights {
			justify-content: center;
		}

		.about__visual {
			order: 2;
			max-width: 500px;
			margin: 0 auto;
		}
	}
</style>
