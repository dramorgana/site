---
import { Image } from "astro:assets";
import logoImg from "../../assets/Header/logo.png";
import "./styles.css";
import { navLinks, logo, cta } from "./data";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<header class={`navbar ${!isHome ? "navbar--visible navbar--scrolled" : ""}`} id="navbar">
  <div class="navbar__container">
    <!-- Logo à esquerda -->
    <a href="/" class="navbar__brand" aria-label="Home Dra. Morgana Motta">
      <Image
        src={logoImg}
        alt={logo.alt}
        class="navbar__logo"
        id="navbar-logo"
        width={180}
        height={45}
        loading="eager"
      />
    </a>

    <!-- Menu Hamburger para Mobile -->
    <button
      class="navbar__toggle"
      id="navbar-toggle"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
    >
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
    </button>

    <!-- Links à direita -->
    <nav class="navbar__nav" id="navbar-menu">
      <ul class="navbar__list">
        {
          navLinks.map((link) => (
            <li class="navbar__item">
              <a href={link.href} class="navbar__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="navbar__cta-wrapper">
        <a
          href={cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="navbar__cta-btn"
        >
          {cta.label}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("navbar");
    const toggle = document.getElementById("navbar-toggle");
    const menu = document.getElementById("navbar-menu");
    const links = document.querySelectorAll(".navbar__link");
    const heroSection = document.getElementById("hero");

    const updateNavbarVisibility = () => {
      if (!navbar) return;

      // Em páginas sem a seção hero (ex: /blog ou /perfil), mantém visível
      if (!heroSection) {
        navbar.classList.add("navbar--visible", "navbar--scrolled");
        return;
      }

      // Surge quando o final da primeira dobra (Hero) passa pelo topo
      const heroBottom = heroSection.getBoundingClientRect().bottom;
      if (heroBottom <= 80) {
        navbar.classList.add("navbar--visible", "navbar--scrolled");
      } else {
        navbar.classList.remove("navbar--visible", "navbar--scrolled");
      }
    };

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateNavbarVisibility();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    // Verificação inicial
    updateNavbarVisibility();

    // Toggle menu mobile
    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", (!isExpanded).toString());
        toggle.classList.toggle("navbar__toggle--active");
        menu.classList.toggle("navbar__nav--active");
        document.body.classList.toggle("menu-open");
      });

      // Fechar menu ao clicar em um link
      links.forEach((link) => {
        link.addEventListener("click", () => {
          toggle.setAttribute("aria-expanded", "false");
          toggle.classList.remove("navbar__toggle--active");
          menu.classList.remove("navbar__nav--active");
          document.body.classList.remove("menu-open");
        });
      });
    }
  });
</script>
