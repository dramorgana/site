---
import "./styles.css";
import { navLinks, logo, cta, headerColors } from "./data";
---

<header class="navbar navbar--visible navbar--scrolled" id="navbar">
  <div class="navbar__container">
    <!-- Logo à esquerda -->
    <a href="/" class="navbar__brand" aria-label="Home Dra. Morgana Motta">
      <img
        src={logo.src}
        alt={logo.alt}
        class="navbar__logo"
        id="navbar-logo"
        width="180"
        height="45"
      />
    </a>

    <!-- Menu Hamburger para Mobile -->
    <button
      class="navbar__toggle"
      id="navbar-toggle"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
    >
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
    </button>

    <!-- Links à direita -->
    <nav class="navbar__nav" id="navbar-menu">
      <ul class="navbar__list">
        {
          navLinks.map((link) => (
            <li class="navbar__item">
              <a href={link.href} class="navbar__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="navbar__cta-wrapper">
        <a
          href={cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="navbar__cta-btn"
        >
          {cta.label}
        </a>
      </div>
    </nav>
  </div>

  <!-- Paletas (temporárias): fundo do header e cor da logo -->
  <div class="navbar__palettes">
    <div class="navbar__palette" role="radiogroup" aria-label="Cor de fundo do header">
      <span class="navbar__palette-label">Fundo</span>
      {
        headerColors.map((color) => (
          <button
            type="button"
            class="navbar__swatch"
            style={`background:${color}`}
            data-color={color}
            role="radio"
            aria-checked="false"
            aria-label={`Fundo ${color}`}
            title={color}
          />
        ))
      }
    </div>
    <div class="navbar__palette" role="radiogroup" aria-label="Cor da logo">
      <span class="navbar__palette-label">Logo</span>
      <button
        type="button"
        class="navbar__logo-swatch navbar__logo-swatch--original navbar__swatch--active"
        data-logo={logo.src}
        role="radio"
        aria-checked="true"
        aria-label="Logo original"
        title="Original"
      />
      {
        headerColors.map((color) => (
          <button
            type="button"
            class="navbar__logo-swatch"
            style={`background:${color}`}
            data-logo={`/images/logo-variations/logo-${color.slice(1).toLowerCase()}.png`}
            data-color={color}
            role="radio"
            aria-checked="false"
            aria-label={`Logo ${color}`}
            title={color}
          />
        ))
      }
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("navbar");
    const toggle = document.getElementById("navbar-toggle");
    const menu = document.getElementById("navbar-menu");
    const links = document.querySelectorAll(".navbar__link");
    const heroSection = document.getElementById("hero");

    // Por hora o header fica sempre visível (lógica de exibição por scroll desativada)
    navbar?.classList.add("navbar--visible", "navbar--scrolled");
    void heroSection;

    // Paleta da logo: troca a imagem pela variação de cor e aplica a mesma cor aos textos do menu
    let logoColor: string | null = null; // null = logo original (texto segue o contraste do fundo)
    let bgText = "#EEE4DB";
    const applyTextColor = () => {
      navbar?.style.setProperty("--nav-text", logoColor ?? bgText);
    };
    const logoImg = document.getElementById("navbar-logo") as HTMLImageElement | null;
    const logoSwatches = document.querySelectorAll<HTMLButtonElement>(".navbar__logo-swatch");
    logoSwatches.forEach((s) =>
      s.addEventListener("click", () => {
        if (!logoImg || !s.dataset.logo) return;
        logoImg.src = s.dataset.logo;
        logoColor = s.dataset.color ?? null;
        applyTextColor();
        logoSwatches.forEach((o) => {
          const active = o === s;
          o.classList.toggle("navbar__swatch--active", active);
          o.setAttribute("aria-checked", String(active));
        });
      }),
    );

    // Paleta de cores: altera o fundo do header
    const swatches = document.querySelectorAll<HTMLButtonElement>(".navbar__swatch");
    const applyColor = (color: string) => {
      if (!navbar) return;
      const r = parseInt(color.slice(1, 3), 16);
      const g = parseInt(color.slice(3, 5), 16);
      const b = parseInt(color.slice(5, 7), 16);
      const isLight = (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.6;
      navbar.style.setProperty("--nav-bg", color);
      navbar.style.setProperty("--nav-bg-scrolled", color);
      bgText = isLight ? "#402E26" : "#EEE4DB";
      applyTextColor();
      navbar.style.setProperty("--nav-accent", isLight ? "#885F4D" : "#D8AF9D");
      swatches.forEach((s) => {
        const active = s.dataset.color === color;
        s.classList.toggle("navbar__swatch--active", active);
        s.setAttribute("aria-checked", String(active));
      });
    };
    swatches.forEach((s) =>
      s.addEventListener("click", () => s.dataset.color && applyColor(s.dataset.color)),
    );

    // Toggle menu mobile
    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", (!isExpanded).toString());
        toggle.classList.toggle("navbar__toggle--active");
        menu.classList.toggle("navbar__nav--active");
        document.body.classList.toggle("menu-open");
      });

      // Fechar menu ao clicar em um link
      links.forEach((link) => {
        link.addEventListener("click", () => {
          toggle.setAttribute("aria-expanded", "false");
          toggle.classList.remove("navbar__toggle--active");
          menu.classList.remove("navbar__nav--active");
          document.body.classList.remove("menu-open");
        });
      });
    }
  });
</script>
