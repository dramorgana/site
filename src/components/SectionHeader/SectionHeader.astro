---
import './styles.css';

interface Props {
	kicker?: string;
	title: string;
	description?: string;
	centered?: boolean;
	className?: string;
}

const { kicker, title, description, centered = false, className = '' } = Astro.props;
---

<header class={`section-header ${centered ? 'section-header--centered' : ''} ${className}`}>
	{kicker && <span class="section-header__kicker">{kicker}</span>}
	<h2 class="section-header__title">{title}</h2>
	{description && <p class="section-header__description">{description}</p>}
	<div class="section-header__divider"></div>
</header>
