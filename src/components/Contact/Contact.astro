---
import { content } from './data';
import SectionHeader from '../SectionHeader/SectionHeader.astro';
import './styles.css';
---

<section id="contato" class="contact">
	<div class="contact__container">
		<div class="contact__info">
			<SectionHeader 
				title={content.title}
				description={content.subtitle}
			/>

			<div class="contact__details">
				<div class="contact__item">
					<h3 class="contact__item-title">Endereço</h3>
					<p class="contact__item-text">{content.address.full}</p>
				</div>

				<div class="contact__item">
					<h3 class="contact__item-title">Canais de Atendimento</h3>
					<ul class="contact__list">
						{
							content.contact.map((item) => (
								<li class="contact__list-item">
									<a href={item.url} class="contact__link">
										<span class="contact__link-type">{item.type}:</span>
										<span class="contact__link-value">{item.value}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>

		<div class="contact__map">
			<div class="contact__map-frame">
				<iframe
					src={content.mapUrl}
					width="100%"
					height="450"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					title="Localização do Consultório"
				></iframe>
			</div>
		</div>
	</div>
</section>
