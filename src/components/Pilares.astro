---
const content = {
	title: "Como transformamos sua saúde.",
	pillars: [
		{
			title: "Avaliação Integrativa",
			text: "Análise profunda de histórico, exames e rotina para compreender a causa raiz.",
			icon: "doc",
		},
		{
			title: "Plano Individualizado",
			text: "Protocolos desenhados exclusivamente para o seu perfil metabólico e objetivos específicos.",
			icon: "user",
		},
		{
			title: "Suporte Contínuo",
			text: "Acompanhamento de perto para ajustes constantes e manutenção de resultados sustentáveis.",
			icon: "heart",
		},
	],
};
---

<section id="pilares" class="pilares">
	<div class="pilares__container">
		<header class="pilares__header">
			<h2 class="pilares__title">{content.title}</h2>
		</header>

		<div class="pilares__grid">
			{
				content.pillars.map((pillar) => (
					<div class="pilares__card">
						<div class="pilares__card-icon-wrapper">
							<div class="pilares__card-icon">
								{pillar.icon === "doc" && (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
									>
										<path
											d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
								{pillar.icon === "user" && (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
									>
										<circle
											cx="12"
											cy="7"
											r="3"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
										<path
											d="M12 21v-4m-4 4l1-1m7 1l-1-1"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
										<path
											d="M19 15.5c-1.5-1-3.5-1.5-7-1.5s-5.5.5-7 1.5c-1.5 1-2 3-2 5h18c0-2-.5-4-2-5z"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
								{pillar.icon === "heart" && (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
									>
										<path
											d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
							</div>
						</div>
						<h3 class="pilares__card-title">{pillar.title}</h3>
						<p class="pilares__card-text">{pillar.text}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	/* ============================================
	   PILARES — Design System
	   ============================================ */
	.pilares {
		padding: 140px 24px;
		background-color: #f8fafc;
		position: relative;
		overflow: hidden;
	}

	.pilares__container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.pilares__header {
		text-align: center;
		margin-bottom: 100px;
	}

	.pilares__title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 6vw, 3.8rem);
		color: var(--color-dark-text);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.pilares__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}

	.pilares__card {
		background: #fff;
		padding: 70px 32px 50px;
		border-radius: 30px;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		position: relative;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);
		border: 1px solid rgba(0, 0, 0, 0.05);
	}

	.pilares__card:hover {
		transform: translateY(-12px);
		box-shadow: 0 40px 80px -20px rgba(45, 58, 54, 0.15);
		border-color: var(--color-sage-light);
	}

	.pilares__card-icon-wrapper {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translate(-50%, -50%);
		z-index: 2;
	}

	.pilares__card-icon {
		width: 90px;
		height: 90px;
		background: var(--color-alabaster);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-sage);
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
		transition: all 0.4s ease;
		border: 8px solid #f8fafc;
	}

	.pilares__card:hover .pilares__card-icon {
		background: var(--color-sage);
		color: #fff;
		transform: scale(1.08);
	}

	.pilares__card-icon svg {
		width: 32px;
		height: 32px;
	}

	.pilares__card-title {
		font-family: var(--font-heading);
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--color-dark-text);
		margin-bottom: 20px;
	}

	.pilares__card-text {
		font-family: var(--font-body);
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-body-text);
	}

	/* ============================================
	   RESPONSIVE PILARES
	   ============================================ */
	@media (max-width: 992px) {
		.pilares {
			padding: 100px 24px;
		}

		.pilares__grid {
			grid-template-columns: 1fr;
			max-width: 450px;
			margin: 0 auto;
			gap: 80px;
		}

		.pilares__header {
			margin-bottom: 80px;
		}
	}
</style>
