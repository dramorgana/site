---
import { content } from './data';
import './styles.css';
---

<section class="parallax-cta">
	<!-- Vídeos de fundo: tocam em sequência e se alternam em loop com transição suave -->
	<div
		class="parallax-cta__video-container"
		data-videos={JSON.stringify(content.videos)}
		aria-hidden="true"
	>
		<video
			class="parallax-cta__video is-active"
			src={content.videos[0]}
			poster={content.images.desktop}
			autoplay
			muted
			playsinline
			preload="auto"
		></video>
		<video
			class="parallax-cta__video"
			src={content.videos[1] || content.videos[0]}
			poster={content.images.desktop}
			muted
			playsinline
			preload="auto"
		></video>
	</div>
	<div class="parallax-cta__overlay"></div>
	<div class="parallax-cta__container">
		<h2 class="parallax-cta__title">{content.title}</h2>
		<p class="parallax-cta__text">
			{content.text}
		</p>
		<div class="parallax-cta__actions">
			<a
				href={content.cta.url}
				target="_blank"
				rel="noopener noreferrer"
				class="parallax-cta__button"
			>
				<svg
					viewBox="0 0 24 24"
					fill="currentColor"
					width="24"
					height="24"
				>
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.432.178.88.28 1.21.085.33-.198.614-.735.794-.545.18-.99.131-1.29-.069-.297-.149-.57-.347-.708-.57-.546-.09-.347-.297-.198-.56l.016-.03c.18-.313.381-.3.545-.3.164 0 .347.002.496.007.163.006.382-.062.581.44.204.516.694 1.7.752 1.822.059.123.1.267.02.428-.079.16-.119.26-.238.397-.119.138-.249.317-.397.486-.149.168-.306.189-.545.064-.237-.124-1.006-.463-1.912-1.488-.674-.765-1.141-1.712-1.19-2.034-.05-.322.035-.513.262-.676l.042-.046c.198-.215.42-.347.669-.347z"/>
					<path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.96 7.96 0 01-4.108-1.14l-.292-.176-2.848.846.846-2.848-.176-.292A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
				</svg>
				{content.cta.text}
			</a>
		</div>
	</div>
</section>

<script>
	const container = document.querySelector(".parallax-cta__video-container") as HTMLElement | null;
	if (container) {
		const videos: string[] = JSON.parse(container.dataset.videos || "[]");
		const videoElements = container.querySelectorAll<HTMLVideoElement>(".parallax-cta__video");

		if (videos.length > 1 && videoElements.length >= 2) {
			let currentIdx = 0;
			let activeVideo = videoElements[0];
			let nextVideo = videoElements[1];
			let isTransitioning = false;
			const CROSSFADE_SEC = 1.6;
			const LEAD_TIME = 2.2; // Antecede o fim do vídeo para garantir sobreposição contínua sem travamento

			const startTransition = () => {
				if (isTransitioning) return;
				isTransitioning = true;

				const nextIdx = (currentIdx + 1) % videos.length;
				const nextSrc = videos[nextIdx];

				if (!nextVideo.src.endsWith(nextSrc)) {
					nextVideo.src = nextSrc;
					nextVideo.load();
				}

				nextVideo.currentTime = 0;

				let hasFaded = false;
				const triggerFade = () => {
					if (hasFaded) return;
					hasFaded = true;

					requestAnimationFrame(() => {
						nextVideo.classList.add("is-entering");

						setTimeout(() => {
							nextVideo.classList.add("is-active");
							nextVideo.classList.remove("is-entering");

							activeVideo.classList.remove("is-active");
							activeVideo.pause();

							// Prepara o próximo vídeo no buffer inativo
							const upcomingIdx = (nextIdx + 1) % videos.length;
							const upcomingSrc = videos[upcomingIdx];
							if (!activeVideo.src.endsWith(upcomingSrc)) {
								activeVideo.src = upcomingSrc;
								activeVideo.load();
							}

							// Alterna as instâncias
							const prevActive = activeVideo;
							activeVideo = nextVideo;
							nextVideo = prevActive;
							currentIdx = nextIdx;
							isTransitioning = false;
						}, CROSSFADE_SEC * 1000);
					});
				};

				// Aguarda o próximo vídeo iniciar os quadros para evitar qualquer salto
				const onPlaying = () => {
					nextVideo.removeEventListener("playing", onPlaying);
					triggerFade();
				};
				nextVideo.addEventListener("playing", onPlaying);

				// Fallback de segurança se o evento demorar
				setTimeout(triggerFade, 250);

				nextVideo.play().catch(() => {
					triggerFade();
				});
			};

			const handleTimeUpdate = (vid: HTMLVideoElement) => {
				if (vid !== activeVideo || isTransitioning) return;
				if (vid.duration && vid.currentTime >= vid.duration - LEAD_TIME) {
					startTransition();
				}
			};

			const handleEnded = (vid: HTMLVideoElement) => {
				if (vid === activeVideo && !isTransitioning) {
					startTransition();
				}
			};

			videoElements.forEach((vid) => {
				vid.addEventListener("timeupdate", () => handleTimeUpdate(vid));
				vid.addEventListener("ended", () => handleEnded(vid));
			});

			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				activeVideo.pause();
				nextVideo.pause();
			}
		} else if (videoElements.length >= 1 && videos.length === 1) {
			const singleVideo = videoElements[0];
			singleVideo.loop = true;
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				singleVideo.pause();
			}
		}
	}
</script>
