---
import { Image } from 'astro:assets';
import clinicReception from '../../assets/clinic_reception.png';
import clinicConsultation from '../../assets/clinic_consultation.png';
import clinicDetail from '../../assets/clinic_detail.png';
import clinicHallway from '../../assets/clinic_hallway.png';
---

<section class="welcoming-environment">
  <div class="env-title-container">
    <h2 class="env-title">Tudo isso somado</h2>
    <h2 class="env-title"> a um ambiente</h2>
    <div class="env-highlight-container">
      <span class="env-highlight">acolhedor</span>
    </div>
    
  </div>

  <div class="env-images">
    <div class="env-img-wrapper img-1">
      <div class="polaroid">
        <Image src={clinicReception} alt="Recepção da clínica" />
        <div class="polaroid-caption">Recepção</div>
      </div>
    </div>
    <div class="env-img-wrapper img-2">
      <div class="polaroid">
        <Image src={clinicDetail} alt="Detalhes do ambiente" />
        <div class="polaroid-caption">Conforto</div>
      </div>
    </div>
    <div class="env-img-wrapper img-3">
      <div class="polaroid">
        <Image src={clinicHallway} alt="Corredor da clínica" />
        <div class="polaroid-caption">Estrutura</div>
      </div>
    </div>
    <div class="env-img-wrapper img-4">
      <div class="polaroid">
        <Image src={clinicConsultation} alt="Consultório médico" />
        <div class="polaroid-caption">Consultório</div>
      </div>
    </div>
  </div>
</section>

<style>
  .welcoming-environment {
    position: relative;
    width: 100%;
    min-height: 80vh;
    background-color: var(--color-alabaster);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px;
    }

  .env-title-container {
    text-align: center;
    z-index: 10;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
        margin-top: -100px;

   }

  .env-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
  }

  .env-highlight-container {
    position: relative;
    margin-top: -10px;
  }

  .env-highlight {
    font-family: serif;
    font-style: italic;
    font-size: 6rem;
    font-weight: 700;
    color: #1a1a1a;
    position: relative;
    z-index: 2;
    padding: 0 10px;
  }

  .env-highlight::before {
    content: "";
    position: absolute;
    bottom: 10%;
    left: -5%;
    width: 110%;
    height: 60%;
    background-color: #59ffd8;
    z-index: -1;
    transform: rotate(-2deg);
  }

  .env-subtitle {
    margin-top: 30px;
    font-size: 1.2rem;
    color: #333;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: rgba(255,255,255,0.8);
    padding: 5px 15px;
    border-radius: 20px;
  }

  .env-images {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .env-img-wrapper {
    position: absolute;
    pointer-events: auto;
    transition: transform 0.3s ease, z-index 0.3s;
  }

  .env-img-wrapper:hover {
    transform: scale(1.05) translateY(-10px) !important;
    z-index: 20 !important;
  }

  .polaroid {
    background: #fff;
    padding: 12px 12px 30px 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border-radius: 4px;
    width: 280px;
  }

  .polaroid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 2px;
  }

  .polaroid-caption {
    text-align: center;
    font-family: 'Courier New', Courier, monospace;
    color: #555;
    margin-top: 10px;
    font-size: 0.9rem;
    font-weight: bold;
  }

  .img-1 {
    top: 15%;
    left: 10%;
    transform: rotate(-12deg);
    z-index: 5;
  }

  .img-2 {
    bottom: 10%;
    left: 20%;
    transform: rotate(8deg);
    z-index: 6;
  }

  .img-3 {
    top: 10%;
    right: 15%;
    transform: rotate(15deg);
    z-index: 4;
  }

  .img-4 {
    bottom: 15%;
    right: 10%;
    transform: rotate(-8deg);
    z-index: 7;
  }

  @media (max-width: 992px) {
    .env-img-wrapper {
      position: relative;
      transform: none !important;
      margin: 20px auto;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
    }

    .env-img-wrapper:hover {
      transform: scale(1.05) !important;
    }

    .env-images {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 40px;
      padding-bottom: 40px;
    }
    
    .welcoming-environment {
      flex-direction: column;
      height: auto;
    }
  }

  @media (max-width: 768px) {
    .env-title {
      font-size: 3rem;
    }
    .env-highlight {
      font-size: 4rem;
    }
  }
</style>
