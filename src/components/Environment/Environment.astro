---
import { Image } from "astro:assets";
import clinicReception from "../../assets/Environment/clinic_reception.webp";
import clinicConsultation from "../../assets/Environment/clinic_consultation.webp";
import clinicDetail from "../../assets/Environment/clinic_detail.webp";
import clinicHallway from "../../assets/Environment/clinic_hallway.webp";
import "./styles.css";
---

<section class="welcoming-environment">
  <div class="env-title-container">
    <span class="env-title">Tudo isso somado</span>
    <span class="env-title"> a um ambiente</span>
    <div class="env-highlight-container">
      <span class="env-highlight">acolhedor</span>
    </div>
  </div>

  <div class="env-images">
    <div class="env-img-wrapper img-1">
      <div class="polaroid">
        <Image
          src={clinicReception}
          alt="Recepção da clínica"
          width={560}
          height={438}
          loading="lazy"
          decoding="async"
        />
        <div class="polaroid-caption">Recepção</div>
      </div>
    </div>
    <div class="env-img-wrapper img-2">
      <div class="polaroid">
        <Image
          src={clinicDetail}
          alt="Detalhes do ambiente"
          width={560}
          height={438}
          loading="lazy"
          decoding="async"
        />
        <div class="polaroid-caption">Conforto</div>
      </div>
    </div>
    <div class="env-img-wrapper img-3">
      <div class="polaroid">
        <Image
          src={clinicHallway}
          alt="Corredor da clínica"
          width={560}
          height={438}
          loading="lazy"
          decoding="async"
        />
        <div class="polaroid-caption">Estrutura</div>
      </div>
    </div>
    <div class="env-img-wrapper img-4">
      <div class="polaroid">
        <Image
          src={clinicConsultation}
          alt="Consultório médico"
          width={560}
          height={438}
          loading="lazy"
          decoding="async"
        />
        <div class="polaroid-caption">Consultório</div>
      </div>
    </div>
  </div>
</section>
