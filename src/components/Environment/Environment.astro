---
import { Image } from "astro:assets";
import clinicReception from "../../assets/clinic_reception.png";
import clinicConsultation from "../../assets/clinic_consultation.png";
import clinicDetail from "../../assets/clinic_detail.png";
import clinicHallway from "../../assets/clinic_hallway.png";
import "./styles.css";
---

<section class="welcoming-environment">
  <div class="env-title-container">
    <span class="env-title">Tudo isso somado</span>
    <span class="env-title"> a um ambiente</span>
    <div class="env-highlight-container">
      <span class="env-highlight">acolhedor</span>
    </div>
  </div>

  <div class="env-images">
    <div class="env-img-wrapper img-1">
      <div class="polaroid">
        <Image src={clinicReception} alt="Recepção da clínica" />
        <div class="polaroid-caption">Recepção</div>
      </div>
    </div>
    <div class="env-img-wrapper img-2">
      <div class="polaroid">
        <Image src={clinicDetail} alt="Detalhes do ambiente" />
        <div class="polaroid-caption">Conforto</div>
      </div>
    </div>
    <div class="env-img-wrapper img-3">
      <div class="polaroid">
        <Image src={clinicHallway} alt="Corredor da clínica" />
        <div class="polaroid-caption">Estrutura</div>
      </div>
    </div>
    <div class="env-img-wrapper img-4">
      <div class="polaroid">
        <Image src={clinicConsultation} alt="Consultório médico" />
        <div class="polaroid-caption">Consultório</div>
      </div>
    </div>
  </div>
</section>
