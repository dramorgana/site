---
import { content } from './data';
---

<section class="final-cta">
	<div class="final-cta__container">
		<h2 class="final-cta__title">{content.title}</h2>
		<p class="final-cta__subtitle">{content.subtitle}</p>
		<a href={content.cta.url} target="_blank" rel="noopener noreferrer" class="final-cta__button">
			{content.cta.text}
		</a>
	</div>
</section>

<style>
	/* ============================================
	   FINAL CTA — Design System
	   ============================================ */
	.final-cta {
		padding: 100px 24px;
		background: linear-gradient(135deg, var(--color-sage) 0%, #2d3a36 100%);
		text-align: center;
		color: #ffffff;
	}

	.final-cta__container {
		max-width: 800px;
		margin: 0 auto;
	}

	.final-cta__title {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.2;
		margin-bottom: 24px;
	}

	.final-cta__subtitle {
		font-family: var(--font-body);
		font-size: 1.2rem;
		opacity: 0.9;
		margin-bottom: 48px;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.final-cta__button {
		display: inline-block;
		padding: 22px 56px;
		background-color: #ffffff;
		color: var(--color-sage);
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 1.1rem;
		text-decoration: none;
		border-radius: 100px;
		transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
		box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
	}

	.final-cta__button:hover {
		transform: translateY(-5px) scale(1.02);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
		background-color: var(--color-alabaster);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.final-cta {
			padding: 80px 24px;
		}

		.final-cta__button {
			width: 100%;
			padding: 20px 32px;
		}
	}
</style>
