---
import { content } from './data';
import './styles.css';
---

<footer class="footer">
	<div class="footer__container">
		<div class="footer__top">
			<div class="footer__brand">
				<h2 class="footer__doctor-name">{content.doctor.name}</h2>
				<p class="footer__doctor-creds">{content.doctor.credentials}</p>
			</div>

			<div class="footer__address">
				<h3 class="footer__title">Onde Estamos</h3>
				<p>{content.address.street}, {content.address.neighborhood}</p>
				<p>{content.address.cityState} • {content.address.cep}</p>
			</div>

			<div class="footer__social">
				<h3 class="footer__title">Redes Sociais</h3>
				<div class="footer__social-links">
					{
						content.social.map((item) => (
							<a href={item.url} target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label={item.label}>
								{item.label}
							</a>
						))
					}
				</div>
			</div>
		</div>

		<div class="footer__bottom">
			<p class="footer__copyright">{content.copyright}</p>
			<nav class="footer__nav">
				{
					content.links.map((link) => (
						<a href={link.url} class="footer__nav-link">
							{link.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>
