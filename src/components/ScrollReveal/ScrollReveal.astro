---
/**
 * ScrollReveal — fade-in do conteúdo conforme o scroll.
 *
 * Os elementos são marcados automaticamente via SELECTORS (sem precisar
 * editar cada componente). Grupos em STAGGER_SELECTORS entram em cascata.
 *
 * - Só esconde o conteúdo se o JS rodar (sem JS / crawlers: tudo visível).
 * - Respeita `prefers-reduced-motion`.
 * - Usa a propriedade `translate` (e não `transform`) para não conflitar
 *   com rotações/animações já existentes nos componentes.
 * - Para marcar manualmente qualquer elemento, use o atributo `data-reveal`.
 */
---

<script is:inline>
	(function () {
		var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (reduceMotion || !("IntersectionObserver" in window)) return;

		// Blocos que entram individualmente
		var SELECTORS = [
			"[data-reveal]",
			".section-header",
			".about__content",
			".about__visual",
			".env-title-container",
			".parallax-cta__title",
			".parallax-cta__text",
			".parallax-cta__actions",
			".contact__details",
			".contact__map",
			".schedule__info",
			".schedule__widget",
		];

		// Itens de grade que entram em cascata (delay incremental)
		var STAGGER_SELECTORS = [
			".servicos__item",
			".pilares__card",
			".env-img-wrapper",
			".faq__item",
			".footer__top > *",
		];

		var STAGGER_STEP = 110; // ms entre itens
		var STAGGER_MAX = 5; // limita o atraso acumulado

		function init() {
			var all = document.querySelectorAll(SELECTORS.concat(STAGGER_SELECTORS).join(","));
			var staggerSet = new Set(document.querySelectorAll(STAGGER_SELECTORS.join(",")));
			var targets = [];

			all.forEach(function (el) {
				// Evita animar um elemento dentro de outro que já anima
				if (el.parentElement && el.parentElement.closest(".reveal")) return;
				// Não anima nada na primeira dobra (Hero)
				if (el.closest("#hero")) return;

				el.classList.add("reveal");

				if (staggerSet.has(el) && el.parentElement) {
					var siblings = Array.prototype.filter.call(el.parentElement.children, function (c) {
						return staggerSet.has(c);
					});
					var index = Math.min(siblings.indexOf(el), STAGGER_MAX);
					el.style.setProperty("--reveal-delay", index * STAGGER_STEP + "ms");
				}

				targets.push(el);
			});

			var observer = new IntersectionObserver(
				function (entries) {
					entries.forEach(function (entry) {
						if (!entry.isIntersecting) return;
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					});
				},
				{ threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
			);

			targets.forEach(function (el) {
				observer.observe(el);
			});
		}

		document.documentElement.classList.add("js-reveal");

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
	})();
</script>

<style is:global>
	.js-reveal .reveal {
		opacity: 0;
		translate: 0 32px;
		transition:
			opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
			translate 0.8s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: var(--reveal-delay, 0ms);
		will-change: opacity, translate;
	}

	.js-reveal .reveal.is-visible {
		opacity: 1;
		translate: 0 0;
		will-change: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.js-reveal .reveal {
			opacity: 1;
			translate: none;
			transition: none;
		}
	}
</style>

