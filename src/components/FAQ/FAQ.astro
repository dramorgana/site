---
import { content } from "./data";
import SectionHeader from "../SectionHeader/SectionHeader.astro";
import "./styles.css";
---

<section id="faq" class="faq">
	<div class="faq__container">
		<div class="faq__header">
			<SectionHeader
				kicker={content.kicker}
				title={content.title}
				description={content.subtitle}
				centered={true}
			/>
		</div>

		<div class="faq__content">
			<div class="faq__list" id="faqList">
				{
					content.questions.slice(0, 10).map((item) => (
						<details
							class="faq__item"
							name="faq-accordion"
						>
							<summary class="faq__question">
								<span class="faq__question-text">
									{item.question}
								</span>
								<span class="faq__icon">
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<path
											d="M19 9l-7 7-7-7"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</span>
							</summary>
							<div class="faq__answer">
								<p>{item.answer}</p>
							</div>
						</details>
					))
				}
			</div>
		</div>
	</div>
</section>
