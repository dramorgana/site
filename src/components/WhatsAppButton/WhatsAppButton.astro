---
import './styles.css';

const whatsappNumber = "5511999999999"; // Substitua pelo número real
const message = encodeURIComponent("Olá Dra. Carolina, gostaria de agendar uma consulta.");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${message}`;
---

<a 
  href={whatsappUrl} 
  class="whatsapp-btn" 
  target="_blank" 
  rel="noopener noreferrer" 
  aria-label="Contato via WhatsApp"
  id="whatsappBtn"
>
  <div class="whatsapp-btn__tooltip">Agende sua consulta</div>
  <svg 
    viewBox="0 0 24 24" 
    width="32" 
    height="32" 
    fill="currentColor"
  >
    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.038 3.284l-.569 2.1 2.18-.572c.945.524 1.99.8 3.117.8 3.18 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.766-5.766zm3.333 8.163c-.145.411-.848.793-1.177.854-.33.061-.733.109-2.147-.464-1.802-.73-2.92-2.575-3.011-2.697-.091-.122-.739-.982-.739-1.964 0-.982.518-1.464.701-1.666.183-.202.403-.253.537-.253.134 0 .268 0 .385.006.124.005.291-.047.456.353.165.4.563 1.371.611 1.47.049.098.081.213.016.342-.065.129-.098.208-.194.319-.096.111-.202.248-.288.334-.1.101-.205.211-.088.411.117.2 0 0 .521.928.775.719 1.405 1.18 1.637 1.272.232.092.366.077.501-.077.135-.154.58-.675.733-.906.153-.23.306-.192.514-.115.208.077 1.318.622 1.544.737.227.115.378.172.433.265.055.093.055.539-.09.95zM12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm.017 21.671c-1.688 0-3.23-.41-4.582-1.134l-3.228.847 1.134-3.085a9.61 9.61 0 0 1-1.34-4.8c0-5.334 4.339-9.674 9.675-9.674s9.674 4.34 9.674 9.674-4.34 9.672-9.674 9.672h-.059z"/>
  </svg>
</a>

<script>
  const whatsappBtn = document.getElementById('whatsappBtn');
  const heroSection = document.getElementById('hero');

  if (whatsappBtn && heroSection) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        // Se o Hero estiver visível (mesmo que parcialmente), esconde o botão
        if (entry.isIntersecting) {
          whatsappBtn.classList.add('whatsapp-btn--hidden');
        } else {
          whatsappBtn.classList.remove('whatsapp-btn--hidden');
        }
      });
    }, {
      threshold: 0.1 // Ativa quando 10% do hero estiver visível
    });

    observer.observe(heroSection);
  }
</script>
