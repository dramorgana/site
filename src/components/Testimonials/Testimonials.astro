---
import { content } from './data';
import SectionHeader from '../SectionHeader/SectionHeader.astro';
import './styles.css';
---

<section id="depoimentos" class="testimonials">
	<!-- Divisor Ondulado Parallax -> Testimonials -->
	<div class="wave-divider wave-divider--testimonials">
		<svg
			data-name="Layer 1"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1200 120"
			preserveAspectRatio="none"
		>
			<path
				d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
				fill="#f0f7f4"></path>
		</svg>
	</div>

	<div class="testimonials__container">
		<SectionHeader 
			title={content.title}
			description={content.subtitle}
			centered={true}
		/>

		<div class="testimonials__carousel-container">
			<button class="carousel-btn prev" id="prevBtn" aria-label="Anterior">
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<path
						d="M15 18l-6-6 6-6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>

			<div class="testimonials__grid" id="testimonialsGrid">
				{
					content.testimonials.map((item) => (
						<div class="testimonial-card">
							<div class="testimonial-card__quote">“</div>
							<p class="testimonial-card__text">{item.text}</p>
							<div class="testimonial-card__author">
								<span class="testimonial-card__name">
									{item.name}
								</span>
								<span class="testimonial-card__meta">
									{item.meta}
								</span>
							</div>
						</div>
					))
				}
			</div>

			<button class="carousel-btn next" id="nextBtn" aria-label="Próximo">
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<path
						d="M9 18l6-6-6-6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>
		</div>
	</div>
</section>

<script>
	const testimonialsGrid = document.getElementById('testimonialsGrid');
	const prevBtn = document.getElementById('prevBtn');
	const nextBtn = document.getElementById('nextBtn');

	if (prevBtn && nextBtn && testimonialsGrid) {
		const scrollAmount = 400;

		nextBtn.addEventListener('click', () => {
			const maxScroll = testimonialsGrid.scrollWidth - testimonialsGrid.clientWidth;
			if (testimonialsGrid.scrollLeft >= maxScroll - 10) {
				testimonialsGrid.scrollTo({ left: 0, behavior: 'smooth' });
			} else {
				testimonialsGrid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
			}
		});

		prevBtn.addEventListener('click', () => {
			if (testimonialsGrid.scrollLeft <= 10) {
				const maxScroll = testimonialsGrid.scrollWidth - testimonialsGrid.clientWidth;
				testimonialsGrid.scrollTo({ left: maxScroll, behavior: 'smooth' });
			} else {
				testimonialsGrid.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
			}
		});
	}
</script>
