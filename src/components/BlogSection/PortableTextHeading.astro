---
const { node } = Astro.props;
const extractText = (children: any[]): string =>
  (children || [])
    .map((c: any) =>
      typeof c?.text === "string" ? c.text : extractText(c?.children || [])
    )
    .join("");
const text = extractText(node?.children || []).trim();
const id = text
  .toLowerCase()
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
const Tag = node?.style === "h3" ? "h3" : node?.style === "h4" ? "h4" : "h2";
---

<Tag id={id || undefined}><slot /></Tag>

