---
interface Post {
  title: string;
  slug: string;
  category: string;
  image: string;
  date: string;
  description: string;
  authorName?: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const mainPost = posts[0];
const secondaryPosts = posts.slice(1, 3);
---

{mainPost && (
  <section class="blog-featured-hero">
    <div class="featured-hero-grid">
      <!-- Card Principal (Grande à Esquerda) -->
      <div class="featured-main-card">
        <a href={`/blog/${mainPost.slug}`} class="featured-image-link">
          <img
            src={mainPost.image}
            alt={mainPost.title}
            class="featured-img"
            loading="eager"
          />
          <div class="featured-overlay"></div>
        </a>
        <div class="featured-content">
          <span class="featured-badge">{mainPost.category}</span>
          <h2 class="featured-title">
            <a href={`/blog/${mainPost.slug}`}>{mainPost.title}</a>
          </h2>
          <p class="featured-excerpt">{mainPost.description}</p>
          <div class="featured-meta">
            <span class="meta-date">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              {mainPost.date}
            </span>
          </div>
        </div>
      </div>

      <!-- Cards Secundários (Empilhados à Direita) -->
      <div class="featured-secondary-stack">
        {secondaryPosts.map((post) => (
          <div class="featured-sub-card">
            <a href={`/blog/${post.slug}`} class="sub-image-link">
              <img
                src={post.image}
                alt={post.title}
                class="sub-img"
                loading="lazy"
              />
              <div class="featured-overlay"></div>
            </a>
            <div class="sub-content">
              <span class="featured-badge">{post.category}</span>
              <h3 class="sub-title">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h3>
              <span class="meta-date">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                {post.date}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
