---
import "./styles.css";
import { posts } from "./data";
import BlogSearchHeader from "./BlogSearchHeader.astro";
import BlogFeaturedHero from "./BlogFeaturedHero.astro";
import BlogCategoryBlock from "./BlogCategoryBlock.astro";

interface Props {
  customPosts?: any[];
  showHero?: boolean;
  showCategoryBlocks?: boolean;
  currentCategory?: string;
}

const {
  customPosts,
  showHero = true,
  showCategoryBlocks = true,
  currentCategory,
} = Astro.props;

const allPosts = customPosts || posts;

// Agrupar posts por categoria para as seções de categoria
const categoriesMap = allPosts.reduce((acc: Record<string, any[]>, post: any) => {
  const cat = post.category || "Geral";
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(post);
  return acc;
}, {});

const categoryKeys = Object.keys(categoriesMap);
---

<section class="blog-page-section" id="blog-page">
  <div class="blog-container-wide">
    <!-- Cabeçalho com Breadcrumbs e Busca -->
    <BlogSearchHeader currentCategory={currentCategory} />

    <!-- Destaque Principal (Hero Grid - Mestre) -->
    {showHero && allPosts.length >= 3 && (
      <BlogFeaturedHero posts={allPosts.slice(0, 3)} />
    )}

    <!-- Seções por Categoria (Layout Mestre) -->
    {showCategoryBlocks && categoryKeys.length > 0 && (
      <div class="blog-categories-wrapper">
        {categoryKeys.map((categoryName) => (
          <BlogCategoryBlock
            categoryName={categoryName}
            posts={categoriesMap[categoryName]}
          />
        ))}
      </div>
    )}

    <!-- Grade Completa de Todos os Artigos -->
    <div class="blog-all-articles-container">
      <h3 class="blog-all-articles-title">Todos os Artigos</h3>

      <div class="blog-mestre-grid">
        {allPosts.map((post: any) => (
          <article class="blog-mestre-card">
            <span class="blog-category">{post.category}</span>
            <div class="blog-image-wrapper">
              <img
                src={post.image}
                srcset={post.srcset}
                sizes="(max-width: 768px) 100vw, 400px"
                alt={post.altText || post.title}
                class="blog-image"
                width={400}
                height={250}
                loading="lazy"
              />
            </div>
            <div class="blog-content">
              <span class="blog-date">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                {post.date}
              </span>
              <h4 class="blog-title">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h4>
              <p class="blog-excerpt">{post.description}</p>
              <div class="blog-footer">
                <div class="blog-author">
                  <div class="author-avatar">
                    <img src={post.authorImage} alt={post.authorName} />
                  </div>
                  <div class="author-info">
                    <span class="author-name">{post.authorName}</span>
                    <span class="author-crm">{post.authorCrm}</span>
                  </div>
                </div>

                <a href={`/blog/${post.slug}`} class="read-more">
                  Ler artigo
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
