---
import { Image } from "astro:assets";
import "./styles.css";
import SectionHeader from "../SectionHeader/SectionHeader.astro";
import { sanityClient, urlFor } from "../../lib/sanity";

interface Post {
  title: string;
  slug: { current: string };
  publishedAt: string;
  mainImage?: any;
  description?: string;
  authorName?: string;
  authorCrm?: string;
  authorImage?: any;
  category?: string;
}

const query = `*[_type == "post"] | order(publishedAt desc) {
  title,
  slug,
  publishedAt,
  mainImage,
  description,
  "authorName": author->name,
  "authorCrm": author->crm,
  "authorImage": author->image,
  "category": categories[0]->title
}`;

const rawPosts = await sanityClient.fetch(query);

// Mapa de resumos originais para garantir que nada fique vazio durante a migração
const DESCRIPTIONS_FALLBACK: Record<string, string> = {
  "importancia-saude-metabolica": "Entenda como o seu metabolismo influencia a perda de peso e por que dietas restritivas podem não ser a solução definitiva.",
  "motivacao-processo-mudanca": "Dicas práticas para sustentar seus novos hábitos e não desistir nos momentos de maior desafio.",
  "alimentacao-consciente": "Saiba como o mindfulness pode transformar sua relação com a comida e auxiliar no controle do peso.",
  "sono-regulacao-hormonal": "Dormir bem é fundamental para o equilíbrio dos hormônios que controlam a fome e a saciedade.",
  "exercicios-resistencia-vs-cardio": "Descubra a combinação ideal de atividades físicas para otimizar a queima de gordura e ganhar massa magra.",
  "suplementacao-inteligente": "Um guia sobre os suplementos que podem auxiliar no seu processo de emagrecimento de forma segura."
};

const DEFAULT_IMAGE = "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&q=80&w=800";

// Formatação de data e tratamento de campos vazios
const posts = rawPosts.map((post: any) => ({
  ...post,
  slug: post.slug.current,
  image: post.mainImage ? urlFor(post.mainImage).width(800).url() : DEFAULT_IMAGE,
  description: post.description || DESCRIPTIONS_FALLBACK[post.slug.current] || "Leia mais sobre este assunto em nosso blog completo.",
  date: new Date(post.publishedAt || new Date()).toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }).replace('.', ''),
  authorName: post.authorName || "Dra. Carolina Mendes",
  authorCrm: post.authorCrm || "CRM-SP 123456",
  authorImage: post.authorImage ? urlFor(post.authorImage).width(100).url() : "https://ui-avatars.com/api/?name=Carolina+Mendes&background=c5a059&color=fff",
  category: post.category || "Saúde Integrativa",
  altText: post.title
}));

interface Props {
  limit?: number;
  showPagination?: boolean;
  customPosts?: any[];
}

const { limit = 3, showPagination = false, customPosts } = Astro.props;
const allPosts = customPosts || posts;
const totalPosts = allPosts.length;
---

<section class="blog-section" id="blog">
  <div class="blog-container">
    <div class="blog-header-area">
      <SectionHeader
        title="Posts e Novidades"
        kicker="Conteúdo Especializado"
        description="Fique por dentro das últimas novidades, dicas e artigos sobre saúde metabólica, emagrecimento e qualidade de vida escritos pela Dra. Carolina Mendes."
        centered={false}
      />

      {
        !showPagination && (
          <div class="blog-all-posts-desktop" style="margin-top: 30px;">
            <a href="/blog" class="btn-secondary">
              Ver todos os artigos no Blog
            </a>
          </div>
        )
      }
    </div>

    <div class="blog-content-area">
      <div 
        class="blog-grid" 
        id="blog-grid" 
        data-limit={limit} 
        data-total={totalPosts}
      >
        {
          allPosts.map((post: any, index: number) => (
            <article
              class={`blog-card ${
                !showPagination && index >= limit ? "hidden" : ""
              }`}
              data-index={index}
              style={`--index: ${index % limit};`}
            >
              <span class="blog-category">{post.category}</span>
              <div class="blog-image-wrapper">
                <Image
                  src={post.image}
                  alt={post.altText}
                  class="blog-image"
                  width={400}
                  height={250}
                  loading="lazy"
                />
              </div>
              <div class="blog-content">
                <span class="blog-date">{post.date}</span>
                <h3 class="blog-title">{post.title}</h3>
                <p class="blog-excerpt">{post.description}</p>
                <div class="blog-footer">
                  <div class="blog-author">
                    <div class="author-avatar">
                      <img 
                        src={post.authorImage} 
                        alt={post.authorName} 
                      />
                    </div>
                    <div class="author-info">
                      <span class="author-name">{post.authorName}</span>
                      <span class="author-crm">{post.authorCrm}</span>
                    </div>
                  </div>

                  <a href={`/blog/${post.slug}`} class="read-more">
                    Ler artigo
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      {
        !showPagination && allPosts.length > limit && (
          <div class="section-pagination">
            <button
              class="pagination-btn"
              id="prev-btn"
              disabled
              aria-label="Anterior"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </button>
            <div class="pagination-dots" id="pagination-dots">
              {Array.from({ length: Math.ceil(allPosts.length / limit) }).map(
                (_, i) => (
                  <span
                    class={`dot ${i === 0 ? "active" : ""}`}
                    data-page={i}
                  />
                )
              )}
            </div>
            <button class="pagination-btn" id="next-btn" aria-label="Próximo">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
          </div>
        )
      }

      {
        !showPagination && (
          <div class="blog-all-posts-mobile">
            <a href="/blog" class="btn-secondary">
              Ver todos os artigos no Blog
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  // Client-side pagination logic
  document.addEventListener("DOMContentLoaded", () => {
    const grid = document.getElementById("blog-grid");
    if (!grid) return;

    // Read variables from data attributes
    const limit = parseInt(grid.getAttribute("data-limit") || "3");
    const total = parseInt(grid.getAttribute("data-total") || "0");

    const cards = grid.querySelectorAll(".blog-card");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const dotsContainer = document.getElementById("pagination-dots");
    if (!dotsContainer) return;

    const dots = dotsContainer.querySelectorAll(".dot");
    let currentPage = 0;
    const totalPages = Math.ceil(total / limit);

    function updatePagination() {
      cards.forEach((card, index) => {
        const start = currentPage * limit;
        const end = start + limit;
        card.classList.remove("animate-in"); // Reset animation

        if (index >= start && index < end) {
          card.classList.remove("hidden");
          // Trigger reflow to restart animation
          // @ts-ignore
          void card.offsetWidth;
          card.classList.add("animate-in");
        } else {
          card.classList.add("hidden");
        }
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle("active", index === currentPage);
      });

      if (prevBtn) (prevBtn as HTMLButtonElement).disabled = currentPage === 0;
      if (nextBtn) (nextBtn as HTMLButtonElement).disabled = currentPage === totalPages - 1;
    }

    function scrollToTop() {
      const section = document.getElementById("blog");
      if (section) {
        const offset = 80; // Buffer for potential sticky site header
        const bodyRect = document.body.getBoundingClientRect().top;
        const elementRect = section.getBoundingClientRect().top;
        const elementPosition = elementRect - bodyRect;
        const offsetPosition = elementPosition - offset;

        window.scrollTo({
          top: offsetPosition,
          behavior: "smooth",
        });
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        if (currentPage > 0) {
          currentPage--;
          updatePagination();
          scrollToTop();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        if (currentPage < totalPages - 1) {
          currentPage++;
          updatePagination();
          scrollToTop();
        }
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const newPage = parseInt(dot.getAttribute("data-page") || "0");
        if (newPage !== currentPage) {
          currentPage = newPage;
          updatePagination();
          scrollToTop();
        }
      });
    });

    // Initial update
    updatePagination();
  });
</script>
