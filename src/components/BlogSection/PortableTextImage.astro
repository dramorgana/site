---
import { getSanityImageAttrs } from "../../lib/sanity";

const { node } = Astro.props;
const alt = node?.alt || "";
const img = getSanityImageAttrs(node, 1000, alt ? alt.slice(0, 60) : undefined);
---

{
  img && (
    <img
      src={img.src}
      alt={alt}
      width={img.width}
      height={img.height}
      loading="lazy"
      decoding="async"
    />
  )
}

