---
interface Post {
  title: string;
  slug: string;
  category: string;
  image: string;
  date: string;
  description: string;
}

interface Props {
  categoryName: string;
  posts: Post[];
}

const { categoryName, posts } = Astro.props;
const mainPost = posts[0];
const minorPosts = posts.slice(1, 4);
---

{mainPost && (
  <div class="blog-cat-block">
    <div class="cat-title-box">
      <h3 class="name-category">{categoryName}</h3>
      <span class="cat-title-accent"></span>
    </div>

    <div class="cat-block-grid">
      <!-- Coluna Esquerda: Post Principal da Categoria -->
      <div class="cat-main-post">
        <div class="item-destaque">
          <a href={`/blog/${mainPost.slug}`} class="cat-image-link">
            <div class="cat-image-wrapper">
              <img src={mainPost.image} alt={mainPost.title} class="cat-img" loading="lazy" />
            </div>
          </a>
          <div class="cat-content">
            <time class="meta-date">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              {mainPost.date}
            </time>
            <h4 class="title-post-blog">
              <a href={`/blog/${mainPost.slug}`}>{mainPost.title}</a>
            </h4>
            <p class="resumo-post-blog">{mainPost.description}</p>
          </div>
        </div>
      </div>

      <!-- Coluna Direita: Lista de Posts Menores (Horizontal Thumbnail + Info) -->
      <div class="cat-minor-posts">
        {minorPosts.map((post) => (
          <div class="item-blog-minor">
            <a href={`/blog/${post.slug}`} class="minor-thumb-link">
              <img src={post.image} alt={post.title} class="minor-img" loading="lazy" />
            </a>
            <div class="minor-info-box">
              <time class="meta-date">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                {post.date}
              </time>
              <h5 class="minor-title">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h5>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
)}
