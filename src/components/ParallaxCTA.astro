---
const content = {
	title: "Pronta para transformar sua saúde e recuperar sua autoestima?",
	text: "Dê o primeiro passo hoje. Agende sua consulta e comece seu protocolo personalizado com acompanhamento médico especializado.",
	cta: {
		text: "Agendar Minha Consulta Agora",
		url: "https://wa.me/5500000000000?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20minha%20avalia%C3%A7%C3%A3o%20m%C3%A9dica.",
	},
};
---

<section class="parallax-cta">
	<div class="parallax-cta__bg"></div>
	<div class="parallax-cta__overlay"></div>
	<div class="parallax-cta__container">
		<h2 class="parallax-cta__title">{content.title}</h2>
		<p class="parallax-cta__text">
			{content.text}
		</p>
		<div class="parallax-cta__actions">
			<a
				href={content.cta.url}
				target="_blank"
				rel="noopener noreferrer"
				class="parallax-cta__button"
			>
				<svg
					viewBox="0 0 24 24"
					fill="currentColor"
					width="24"
					height="24"
				>
					<path
						d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.432.178.88.28 1.21.085.33-.198.614-.735.794-.545.18-.99.131-1.29-.069-.297-.149-.57-.347-.708-.57-.546-.09-.347-.297-.198-.56l.016-.03c.18-.313.381-.3.545-.3.164 0 .347.002.496.007.163.006.382-.062.581.44.204.516.694 1.7.752 1.822.059.123.1.267.02.428-.079.16-.119.26-.238.397-.119.138-.249.317-.397.486-.149.168-.306.189-.545.064-.237-.124-1.006-.463-1.912-1.488-.674-.765-1.141-1.712-1.19-2.034-.05-.322.035-.513.262-.676l.042-.046c.198-.215.42-.347.669-.347z"
					></path>
					<path
						d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.96 7.96 0 01-4.108-1.14l-.292-.176-2.848.846.846-2.848-.176-.292A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"
					></path>
				</svg>
				{content.cta.text}
			</a>
		</div>
	</div>
</section>

<style>
	/* ============================================
	   CTA PARALLAX — Design System
	   ============================================ */
	.parallax-cta {
		position: relative;
		padding: 180px 24px;
		text-align: center;
		overflow: hidden;
		color: #ffffff;
		background-color: #0a140f;
		min-height: 550px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.parallax-cta__bg {
		position: absolute;
		inset: 0;
		background-image: url("/images/parallax-cta-bg-v3.png");
		background-attachment: fixed; /* Efeito Parallax Clássico */
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		z-index: 0;
		animation: pan360 80s linear infinite alternate;
		will-change: background-position;
	}

	/* No mobile, o background-attachment: fixed costuma ser problemático */
	@media (max-width: 1024px) {
		.parallax-cta__bg {
			background-attachment: scroll;
		}
	}

	@keyframes pan360 {
		0% {
			background-position: 45% center;
		}
		100% {
			background-position: 55% center;
		}
	}

	.parallax-cta__overlay {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at center,
			rgba(0, 0, 0, 0.4) 0%,
			rgba(10, 20, 15, 0.85) 100%
		);
		z-index: 1;
	}

	.parallax-cta__container {
		position: relative;
		z-index: 2;
		max-width: 800px;
		margin: 0 auto;
		animation: fadeIn 1s ease-out both;
		text-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
		color: #ffffff;
	}

	.parallax-cta__title {
		font-family: var(--font-heading);
		font-size: clamp(2.4rem, 6vw, 3.8rem);
		font-weight: 700;
		line-height: 1.1;
		margin-bottom: 32px;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.parallax-cta__text {
		font-family: var(--font-body);
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		line-height: 1.6;
		margin-bottom: 48px;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		color: #ffffff;
	}

	.parallax-cta__button {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 22px 48px;
		background-color: #25d366;
		color: #fff;
		border-radius: 100px;
		font-family: var(--font-body);
		font-size: 1.1rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
		box-shadow: 0 15px 30px rgba(37, 211, 102, 0.2);
	}

	.parallax-cta__button:hover {
		background-color: #128c7e;
		transform: translateY(-5px);
		box-shadow: 0 20px 40px rgba(37, 211, 102, 0.3);
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* --- Responsive --- */
	@media (max-width: 768px) {
		.parallax-cta {
			padding: 100px 20px;
			min-height: 450px;
		}

		.parallax-cta__title {
			font-size: 2.2rem;
		}

		.parallax-cta__button {
			width: 100%;
			justify-content: center;
			padding: 20px 32px;
		}
	}
</style>
