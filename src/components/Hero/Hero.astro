---
import { doctor, headline, cta, background } from "./data";
import { urlFor } from "../../lib/sanity";
import "./styles.css";

const _doctorName =
	doctor && doctor.name && doctor.name.trim()
		? doctor.name.trim()
		: "Morgana Motta";
const _prefix =
	doctor && doctor.prefix && doctor.prefix.trim()
		? doctor.prefix.trim()
		: "Dra.";
const _specialty =
	doctor && doctor.specialty && doctor.specialty.trim()
		? doctor.specialty.trim()
		: "Emagrecimento e ganho de massa muscular";
const _credentials =
	doctor && doctor.credentials && doctor.credentials.trim()
		? doctor.credentials.trim()
		: "CRM 96204";

// Construção automática da URL do WhatsApp
const whatsappUrl =
	cta && cta.phone
		? `https://wa.me/${cta.phone.replace(/\D/g, "")}?text=${encodeURIComponent(cta.message || "")}`
		: "#";
---

<slot name="head">
	<link
		rel="preload"
		as="image"
		href="/images/hero-section/hero-3168w.webp"
		imagesrcset="
			/images/hero-section/hero-480w.webp   480w,
			/images/hero-section/hero-768w.webp   768w,
			/images/hero-section/hero-1024w.webp 1024w,
			/images/hero-section/hero-1280w.webp 1280w,
			/images/hero-section/hero-1920w.webp 1920w,
			/images/hero-section/hero-2560w.webp 2560w,
			/images/hero-section/hero-3168w.webp 3168w
		"
		imagesizes="100vw"
		fetchpriority="high"
	/>
</slot>

<section id="hero" class="hero">
	<!-- Background image full-bleed -->
	<div class="hero__bg">
		<div class="hero__bg-wrapper">
			<picture>
				<source
					type="image/webp"
					srcset="
						/images/hero-section/hero-480w.webp   480w,
						/images/hero-section/hero-768w.webp   768w,
						/images/hero-section/hero-1024w.webp 1024w,
						/images/hero-section/hero-1280w.webp 1280w,
						/images/hero-section/hero-1920w.webp 1920w,
						/images/hero-section/hero-2560w.webp 2560w,
						/images/hero-section/hero-3168w.webp 3168w
					"
					sizes="100vw"
				/>
				<img
					src="/images/hero-section/hero-image.jpg"
					alt={background.alt || `${_prefix} ${_doctorName}`}
					class="hero__bg-image"
					loading="eager"
					fetchpriority="high"
					width="3168"
					height="1344"
				/>
			</picture>
		</div>
		<div class="hero__bg-overlay"></div>
	</div>

	<!-- Content Container -->
	<div class="hero__container">
		<div class="hero__content-box">
			<!-- Título Principal em Destaque: Logo ao Lado Esquerdo Alinhada Verticalmente com o Nome -->
			<header class="hero__header">
				<h1 class="hero__brand">
					<div class="hero__brand-row">
						<div class="hero__doctor-details">
							<span class="hero__doctor-name-text"
								>{_prefix}
								<span>{doctor.name}</span>
								<span class="hero__doctor-crm"
									>{_credentials}</span
								>
								<span class="hero__doctor-specialty"
									>{_specialty}</span
								>
							</span>
						</div>
					</div>
				</h1>

				<!-- Headline de Impacto Abaixo do Título -->
				<h2 class="hero__headline">
					<Fragment set:html={headline.main} />
				</h2>

				<!-- Subtítulo / Descrição Accent -->
				{
					headline.accent && (
						<p class="hero__headline-accent">
							<Fragment set:html={headline.accent} />
						</p>
					)
				}

				<!-- CTA WhatsApp -->
				<div class="hero__actions">
					<a
						href={whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="hero__cta"
						id="hero-cta-whatsapp"
					>
						<span class="hero__cta-text">{cta.text}</span>
						<svg
							class="hero__cta-arrow"
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				</div>
			</header>
		</div>
	</div>

	<script>
		const heroWrapper = document.querySelector(
			".hero__bg-wrapper",
		) as HTMLElement;
		if (heroWrapper) {
			let ticking = false;
			window.addEventListener(
				"scroll",
				() => {
					if (!ticking) {
						window.requestAnimationFrame(() => {
							const scrollValue = window.scrollY;
							if (scrollValue < window.innerHeight) {
								heroWrapper.style.transform = `translate3d(0, ${scrollValue * 0.4}px, 0)`;
							}
							ticking = false;
						});
						ticking = true;
					}
				},
				{ passive: true },
			);
		}
	</script>
</section>
